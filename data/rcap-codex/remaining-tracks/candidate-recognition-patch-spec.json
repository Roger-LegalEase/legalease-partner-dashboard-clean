      "trackId",
      "treatment=exact_supported_deferral",
      "exactReason",
      "evidencePaths[]",
      "paymentAllowed=false",
      "sellable=false",
      "checkoutProhibited=true",
      "creditConsumable=false"
    ],
    "generatorPath": "scripts/generate-rcap-track-terminalization.mjs",
    "algorithm": [
      "Read and schema-validate the machine-readable deferral input beside the existing hard-form deferral discovery.",
      "Reject duplicate track IDs across hard-form and lane-B deferral sources; never resolve duplicates by last writer wins.",
      "Reject an entry unless every evidence path exists, treatment is exact_supported_deferral, exactReason is nonempty, and all payment/checkout/credit suppression values are the required fail-closed values.",
      "Record the validated entry as candidateTreatment/candidateEvidence/treatmentSubstitution only; do not make delivery itself terminal.",
      "Continue to require the exact current F2 technical_approved closure for promotion. A missing, held, or correction_required review cannot promote.",
      "Sort records by jurisdiction then trackId and keep generated bytes independent of wall-clock time."
    ],
    "prohibitedShortcuts": [
      "Do not parse Markdown heuristically inside the terminalization generator.",
      "Do not treat all guidance packets as exact deferrals.",
      "Do not bypass the F2 promotion signal.",
      "Do not enable a route, checkout, payment, credit consumption, staging, or launch flag."
    ]
  },
