  "schemaVersion": "rcap-external-counsel-adoption/v1",
  "recordId": "EXT-ADOPT-01-standing-external-counsel-adoption",
  "status": "adopted",
  "adoptedOn": "2026-08-08",
  "recordedOn": "2026-08-09",
  "recordedBy": "Session A integration captain",
  "approvedByRole": "external_licensed_counsel",
  "approvalBasis": "external_counsel_adoption_attested_by_project_owner",
  "whatThisRecordIs": "The standing external counsel adoption of the current RCAP packet corpus, recorded from the project owner’s attestation. It is the legal gate only.",
  "whyNotSessionR": "Session R did not write these. Recording them as Session R legal recommendations would attribute work to a session that did not do it and would fabricate recommend_adopt results. This is an external adoption on its own path, and it is labelled as one.",
  "provenance": {
    "evidenceType": "project_owner_attestation_of_counsel_adoption",
    "attestedBy": "Roger Roman",
    "attestedRole": "LegalEase project owner",
    "attestedDate": "2026-08-08",
    "counselIdentityRecorded": false,
    "counselIdentityNotFabricated": "No attorney name, bar number, signature, engagement or letter is asserted, because none was supplied.",
    "underlyingCounselAdoptionRetainedExternally": true,
    "repositoryCopyAvailable": false,
    "additionalEvidenceRequired": false,
    "authorityReviewedThrough": "2026-08-08"
  },
  "scope": {
    "level": "packet_family",
    "standing": true,
    "jurisdictionsNormalized": 51,
    "familiesInScope": 57,
    "corpusReviewedThrough": "2026-08-08",
    "covers": [
      "every currently implemented packet family",
      "every current packet proof",
      "every current review manifest",
      "every current custom-pleading family",
      "every current guidance family",
      "every current official-PDF family",
      "every current composed route"
    ]
  },
  "continuityPolicy": {
    "continuesAcross": [
      "regenerated evidence",
      "proof regeneration",
      "review-manifest regeneration",
      "source-path portability changes",
      "layout-only corrections",
      "fixture corrections",
      "technical corrections that do not change the substantive legal document",
      "corrected outputs that restore the family to the already adopted legal design"
    ],
    "doesNotRequireNewAdoptionFor": [
      "a PDF hash change from pagination or appearance correction",
      "a corrected fixture",
      "a source path becoming portable",
      "a receipt recreated without changing source bytes",
      "an implementation verifier change that does not change legal substance"
    ],
    "newAdoptionRequiredOnlyWhenAChangeAfter20260808MateriallyChanges": [
      "governing mechanism",
      "legal eligibility",
      "waiting period",
      "filing actor",
      "venue",
      "required allegations",
      "legal document type",
      "remedy",
      "controlling legal authority",
      "substantive participant-facing legal text"
    ]
  },
  "whatThisDoesNotWaive": {
    "note": "Counsel adoption clears the legal gate and nothing else. Every one of these remains an independent gate and is unaffected.",
    "gates": [
      "technical and visual review",
      "source identity",
      "source currentness",
      "source materialization",
      "field mapping",
      "geometry",
      "legal-design blockers",
      "implementation completion",
      "runtime enablement"
    ]
  },
  "staleOrDefectiveOutputPolicy": {
    "rule": "Counsel adoption does not make a stale or defective artifact the current packet. A family carrying correction_required, superseded, stale_proof, stale_manifest, held_on_source_or_design, assignment_superseded or implementation_incomplete keeps that status until the correction lands.",
    "onceCorrected": "When the corrected implementation, proof and manifest are regenerated and the family again matches the adopted legal design, this standing adoption attaches automatically. No further external counsel request is made for a correction that does not change legal substance."
  },
