{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rcap-official-pdf-fixture-scaffold/v1",
  "title": "RCAP official PDF fixture scaffold",
  "type": "object",
  "required": [
    "schemaVersion",
    "familyId",
    "jurisdiction",
    "syntheticDataOnly",
    "fixtureState",
    "tracks",
    "requiredBoundaryFixtures"
  ],
  "properties": {
    "schemaVersion": {
      "const": "rcap-official-pdf-fixture-scaffold/v1"
    },
    "familyId": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "syntheticDataOnly": {
      "const": true
    },
    "fixtureState": {
      "enum": [
        "pending_field_map_and_fact_type_binding",
        "bound",
        "rendered"
      ]
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "trackId",
          "fixtureId",
          "caseReference",
          "requiredFactKeys",
          "conditionalFactKeys",
          "manualCompletionItems"
        ],
        "properties": {
          "trackId": {
            "type": "string",
            "minLength": 1
          },
          "fixtureId": {
            "type": "string",
            "minLength": 1
          },
          "caseReference": {
            "type": "string",
            "pattern": "^SYN-"
          },
          "requiredFactKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conditionalFactKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manualCompletionItems": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "item",
                "whereInPacket",
                "expectedTreatment"
              ]
            }
          }
        }
      }
    },
    "requiredBoundaryFixtures": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true
    }
  }
}
