{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rcap-mo-official-pdf-field-ownership.schema.json",
  "title": "Missouri official-PDF field ownership scaffold",
  "type": "object",
  "required": [
    "schemaVersion",
    "familyId",
    "jurisdiction",
    "automationPolicy",
    "documents"
  ],
  "properties": {
    "schemaVersion": {
      "const": "rcap-official-pdf-field-ownership/v1"
    },
    "familyId": {
      "const": "rcap-mo-official-pdf-family"
    },
    "jurisdiction": {
      "const": "MO"
    },
    "automationPolicy": {
      "type": "object",
      "required": [
        "activeWritableFieldCount",
        "signaturesAlwaysManual",
        "swornStatementsAlwaysManual",
        "notarialCompletionAlwaysManual",
        "unknownOwnerDefaultsToProtected",
        "protectedOwnerClasses"
      ],
      "properties": {
        "activeWritableFieldCount": {
          "const": 0
        },
        "signaturesAlwaysManual": {
          "const": true
        },
        "swornStatementsAlwaysManual": {
          "const": true
        },
        "notarialCompletionAlwaysManual": {
          "const": true
        },
        "unknownOwnerDefaultsToProtected": {
          "const": true
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": [
          "componentDocumentId",
          "identityBindingStatus",
          "classificationStatus",
          "activeWritableFields",
          "manualParticipantBlocks",
          "protectedBlocks"
        ],
        "properties": {
          "activeWritableFields": {
            "type": "array",
            "maxItems": 0
          },
          "protectedBlocks": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  },
  "additionalProperties": true
}
