{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rcap-az-official-pdf-field-ownership.schema.json",
  "title": "Arizona official-PDF field ownership scaffold",
  "type": "object",
  "required": [
    "schemaVersion",
    "familyId",
    "jurisdiction",
    "automationPolicy",
    "documents"
  ],
  "properties": {
    "schemaVersion": {
      "const": "rcap-official-pdf-field-ownership/v1"
    },
    "familyId": {
      "const": "rcap-az-official-pdf-family"
    },
    "jurisdiction": {
      "const": "AZ"
    },
    "automationPolicy": {
      "type": "object",
      "required": [
        "activeWritableFieldCount",
        "signaturesAlwaysManual",
        "swornStatementsAlwaysManual",
        "unknownOwnerDefaultsToProtected",
        "protectedOwnerClasses"
      ],
      "properties": {
        "activeWritableFieldCount": {
          "const": 0
        },
        "signaturesAlwaysManual": {
          "const": true
        },
        "swornStatementsAlwaysManual": {
          "const": true
        },
        "unknownOwnerDefaultsToProtected": {
          "const": true
        },
        "protectedOwnerClasses": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": [
          "componentDocumentId",
          "identityBindingStatus",
          "classificationStatus",
          "activeWritableFields",
          "manualParticipantBlocks",
          "protectedBlocks"
        ],
        "properties": {
          "componentDocumentId": {
            "type": "string"
          },
          "identityBindingStatus": {
            "enum": [
              "exact_pinned_identity",
              "unknown_source_identity"
            ]
          },
          "classificationStatus": {
            "enum": [
              "pending_captain_projection_inspection",
              "prohibited_unknown_source_identity"
            ]
          },
          "activeWritableFields": {
            "type": "array",
            "maxItems": 0
          },
          "manualParticipantBlocks": {
            "type": "array"
          },
          "protectedBlocks": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  },
  "additionalProperties": true
}
