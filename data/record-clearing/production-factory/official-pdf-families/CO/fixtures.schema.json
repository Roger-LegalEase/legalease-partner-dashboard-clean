{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalease.example/schemas/co-jdf-fixtures-v1.json",
  "title": "Colorado JDF synthetic preflight fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "familyId",
    "jurisdiction",
    "thirdPartyOwnersAlwaysBlank",
    "fixtures"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "familyId": { "const": "co-statewide-jdf-official-form-family" },
    "jurisdiction": { "const": "CO" },
    "thirdPartyOwnersAlwaysBlank": {
      "const": [
        "court",
        "clerk",
        "judge",
        "prosecutor",
        "law_enforcement",
        "agency",
        "notary",
        "process_server"
      ]
    },
    "fixtures": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "factValue": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "boolean" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureId",
        "routeId",
        "packetSetId",
        "synthetic",
        "facts",
        "requiredFactKeys",
        "manualFieldsExpectedBlank",
        "primaryBlockers",
        "expectedGateResult"
      ],
      "properties": {
        "fixtureId": { "type": "string", "pattern": "^co-fixture-" },
        "routeId": { "type": "string", "pattern": "^co_" },
        "packetSetId": { "type": "string", "pattern": "^co_" },
        "synthetic": { "const": true },
        "facts": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "$ref": "#/$defs/factValue" }
        },
        "requiredFactKeys": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          }
        },
        "manualFieldsExpectedBlank": {
          "const": ["participantSignature", "participantSignatureDate"]
        },
        "primaryBlockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "expectedGateResult": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currentWorkspace",
            "wrongBytes",
            "exactCandidateBytes",
            "runtime"
          ],
          "properties": {
            "currentWorkspace": { "const": "blocked_fail_closed" },
            "wrongBytes": { "const": "source_fingerprint_mismatch" },
            "exactCandidateBytes": {
              "const": "blocked_pending_identity_mapping_technical_visual_and_legal_gates"
            },
            "runtime": { "const": "runtime_disabled" }
          }
        }
      }
    }
  }
}
