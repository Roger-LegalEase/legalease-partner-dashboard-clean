{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rcap-official-pdf-field-ownership/v1",
  "title": "RCAP official PDF field ownership map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "familyId",
    "jurisdiction",
    "ownerClasses",
    "forms"
  ],
  "properties": {
    "schemaVersion": {
      "const": "rcap-official-pdf-field-ownership/v1"
    },
    "familyId": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "ownerClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "participant",
          "system_derived",
          "participant_manual",
          "court",
          "judge",
          "clerk",
          "prosecutor",
          "agency",
          "attorney",
          "notary",
          "process_server",
          "prohibited_from_generation",
          "not_applicable"
        ]
      }
    },
    "forms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "status",
          "expectedFieldCount",
          "coverageComplete",
          "fields"
        ],
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending_materialization",
              "inventory_verified",
              "ownership_reviewed"
            ]
          },
          "expectedFieldCount": {
            "type": "integer",
            "minimum": 1
          },
          "coverageComplete": {
            "type": "boolean"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pdfFieldName",
                "fieldType",
                "owner",
                "mapped"
              ],
              "properties": {
                "pdfFieldName": {
                  "type": "string",
                  "minLength": 1
                },
                "fieldType": {
                  "enum": [
                    "text",
                    "checkbox",
                    "radio",
                    "dropdown",
                    "other"
                  ]
                },
                "owner": {
                  "enum": [
                    "participant",
                    "system_derived",
                    "participant_manual",
                    "court",
                    "judge",
                    "clerk",
                    "prosecutor",
                    "agency",
                    "attorney",
                    "notary",
                    "process_server",
                    "prohibited_from_generation",
                    "not_applicable"
                  ]
                },
                "mapped": {
                  "type": "boolean"
                },
                "factKey": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
