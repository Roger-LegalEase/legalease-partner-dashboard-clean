{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rcap-ar-official-pdf-field-ownership/v1",
  "title": "Arkansas ACIC official PDF field ownership map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "familyId",
    "jurisdiction",
    "ownerClasses",
    "policy",
    "forms"
  ],
  "properties": {
    "schemaVersion": {
      "const": "rcap-official-pdf-field-ownership/v1"
    },
    "familyId": {
      "const": "rcap-ar-official-pdf-family"
    },
    "jurisdiction": {
      "const": "AR"
    },
    "ownerClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "policy": {
      "type": "object"
    },
    "forms": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "officialFormId",
          "documentRole",
          "sourceAuthorityState",
          "status",
          "expectedFieldCount",
          "measurementBasis",
          "coverageComplete",
          "knownManualCompletionItems",
          "fields"
        ],
        "properties": {
          "officialFormId": {
            "type": "string"
          },
          "documentRole": {
            "enum": ["primary_filing", "proposed_order"]
          },
          "sourceAuthorityState": {
            "const": "authority_unmanifested_source"
          },
          "status": {
            "const": "blocked_authority_unmanifested"
          },
          "expectedFieldCount": {
            "type": "null"
          },
          "measurementBasis": {
            "const": "no_exact_authority_asset"
          },
          "coverageComplete": {
            "const": false
          },
          "knownManualCompletionItems": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["semanticItem", "owner", "mappingState"],
              "properties": {
                "semanticItem": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                },
                "mappingState": {
                  "const": "semantic_policy_only_no_pdf_field_asserted"
                }
              }
            }
          },
          "fields": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  }
}
