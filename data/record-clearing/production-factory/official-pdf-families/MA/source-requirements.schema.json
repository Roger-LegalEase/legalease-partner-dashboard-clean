{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalease.example/schemas/ma-official-pdf-source-requirements-v1.json",
  "title": "Massachusetts official-PDF source requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "normativeRequirementSchema",
    "contractState",
    "assignmentManifest",
    "portableProjectionAvailable",
    "familyId",
    "jurisdiction",
    "asOf",
    "runtimePosture",
    "physicalSourceCount",
    "routeCount",
    "authorityPins",
    "documents",
    "inventoryExclusions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "normativeRequirementSchema": {
      "const": "rcap-source-materialization-requirement/v1"
    },
    "contractState": { "const": "pending_captain_owned_assignment" },
    "assignmentManifest": { "type": "null" },
    "portableProjectionAvailable": { "const": false },
    "familyId": { "const": "ma-trial-court-official-pdf-families" },
    "jurisdiction": { "const": "MA" },
    "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "runtimePosture": { "const": "fail_closed_pending_captain_assignment" },
    "physicalSourceCount": { "const": 5 },
    "routeCount": { "const": 6 },
    "authorityPins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityEdition",
        "authorityArchiveSha256",
        "legalReview",
        "legalReviewAddendum",
        "planningJob",
        "generatedFactoryJobs"
      ],
      "properties": {
        "authorityEdition": { "const": "1.2" },
        "authorityArchiveSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "legalReview": { "$ref": "#/$defs/authorityAsset" },
        "legalReviewAddendum": { "$ref": "#/$defs/authorityAsset" },
        "planningJob": { "type": "string", "minLength": 1 },
        "generatedFactoryJobs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/sourceRequirement" }
    },
    "inventoryExclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "reason", "runtimeUse"],
        "properties": {
          "artifactId": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "runtimeUse": { "const": "none" }
        }
      }
    }
  },
  "$defs": {
    "authorityAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowKey",
        "revision",
        "sha256",
        "canonicalRelativePath",
        "generationAllowed",
        "runtimeStatus"
      ],
      "properties": {
        "workflowKey": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "canonicalRelativePath": { "type": "string", "minLength": 1 },
        "generationAllowed": { "const": false },
        "runtimeStatus": { "const": "runtime_disabled" }
      }
    },
    "expectedBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "mimeType", "pdfMagicHex"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "mimeType": { "const": "application/pdf" },
        "pdfMagicHex": { "const": "25504446" }
      }
    },
    "technicalExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "pageCount",
        "fieldCount",
        "xfa",
        "encrypted",
        "evidenceState",
        "rendererCandidate"
      ],
      "properties": {
        "classification": { "type": "string", "minLength": 1 },
        "pageCount": { "type": "integer", "minimum": 1 },
        "fieldCount": { "type": "integer", "minimum": 0 },
        "xfa": { "type": ["boolean", "null"] },
        "encrypted": { "type": ["boolean", "null"] },
        "evidenceState": {
          "enum": [
            "historical_registry_measurement_requires_reinspection",
            "historical_registry_conflict_requires_reinspection",
            "legacy_candidate_rejected_for_current_rendering"
          ]
        },
        "rendererCandidate": {
          "enum": [
            "acroform_fill_pending_exact_source_inspection",
            "coordinate_overlay_pending_current_source_and_coordinates",
            "unsupported_pending_format_resolution"
          ]
        }
      }
    },
    "materializationDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "satisfiedBy"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "state": {
          "enum": [
            "required",
            "blocked",
            "pending_human_review",
            "not_satisfied"
          ]
        },
        "satisfiedBy": { "type": "string", "minLength": 1 }
      }
    },
    "sourceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "artifactId",
        "acquisitionIds",
        "documentId",
        "officialTitle",
        "issuingBody",
        "revision",
        "routeIds",
        "componentIds",
        "contractState",
        "repositorySourcePath",
        "repositorySourcePathTreatment",
        "portableLocatorCandidate",
        "proposedMaterializationDestination",
        "verificationCommandCandidate",
        "assignmentBinding",
        "officialIndexUrl",
        "directOfficialUrl",
        "canonicalAuthorityAsset",
        "expected",
        "fingerprintDisposition",
        "materializationState",
        "workerMayRead",
        "workerMaterializationAuthorized",
        "workerMayModify",
        "technicalExpectation",
        "materializationDependencies",
        "generationAllowed",
        "runtimeStatus"
      ],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^ma-[a-z0-9-]+$" },
        "artifactId": { "type": "string", "minLength": 1 },
        "acquisitionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^acquire:MA:" }
        },
        "documentId": { "type": "string", "minLength": 1 },
        "officialTitle": { "type": "string", "minLength": 1 },
        "issuingBody": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "routeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ma-" }
        },
        "componentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ma-" }
        },
        "contractState": { "const": "pending_captain_owned_assignment" },
        "repositorySourcePath": {
          "type": "string",
          "pattern": "^private/Nationwide Record Clearing/LegalEase massachusetts/"
        },
        "repositorySourcePathTreatment": {
          "const": "identity_evidence_only"
        },
        "portableLocatorCandidate": { "type": "string", "minLength": 1 },
        "proposedMaterializationDestination": {
          "type": "string",
          "pattern": "^official-pdf-sources/MA/[A-Za-z0-9._-]+\\.pdf$"
        },
        "verificationCommandCandidate": {
          "type": "string",
          "pattern": "^node scripts/verify-rcap-materialized-source\\.mjs --document-id "
        },
        "assignmentBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assignmentJobId",
            "assignmentBaseCommit",
            "assignmentManifestSha256",
            "state"
          ],
          "properties": {
            "assignmentJobId": { "type": "null" },
            "assignmentBaseCommit": { "type": "null" },
            "assignmentManifestSha256": { "type": "null" },
            "state": { "const": "captain_owned_assignment_required" }
          }
        },
        "officialIndexUrl": { "type": "string", "pattern": "^https://www\\.mass\\.gov/" },
        "directOfficialUrl": { "type": "string", "pattern": "^https://" },
        "canonicalAuthorityAsset": {
          "type": ["object", "null"],
          "required": [
            "workflowKey",
            "assetClass",
            "canonicalRelativePath"
          ],
          "properties": {
            "workflowKey": { "type": "string", "minLength": 1 },
            "assetClass": { "const": "source_gated" },
            "canonicalRelativePath": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "expected": { "$ref": "#/$defs/expectedBytes" },
        "fingerprintDisposition": {
          "enum": [
            "historical_candidate_pending_manual_official_diff",
            "source_gated_candidate_pending_currentness",
            "legacy_candidate_requires_replacement",
            "source_gated_candidate_with_format_conflict"
          ]
        },
        "materializationState": { "const": "binary_materialization_required" },
        "workerMayRead": { "const": false },
        "workerMaterializationAuthorized": { "const": false },
        "workerMayModify": { "const": false },
        "technicalExpectation": { "$ref": "#/$defs/technicalExpectation" },
        "materializationDependencies": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/materializationDependency" }
        },
        "generationAllowed": { "const": false },
        "runtimeStatus": { "const": "runtime_disabled" }
      }
    }
  }
}
