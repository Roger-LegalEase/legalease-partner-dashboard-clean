{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rcap-ak-official-pdf-field-ownership.schema.json",
  "title": "Alaska official-PDF field ownership scaffold",
  "type": "object",
  "required": [
    "schemaVersion",
    "familyId",
    "jurisdiction",
    "automationPolicy",
    "documents"
  ],
  "properties": {
    "schemaVersion": {
      "const": "rcap-official-pdf-field-ownership/v1"
    },
    "familyId": {
      "const": "rcap-ak-official-pdf-family"
    },
    "jurisdiction": {
      "const": "AK"
    },
    "automationPolicy": {
      "type": "object",
      "required": [
        "activeWritableFieldCount",
        "signaturesAlwaysManual",
        "protectedOwnerClasses"
      ],
      "properties": {
        "activeWritableFieldCount": {
          "const": 0
        },
        "signaturesAlwaysManual": {
          "const": true
        },
        "protectedOwnerClasses": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "componentDocumentId",
          "fieldEnumerationStatus",
          "activeWritableFields",
          "manualParticipantBlocks",
          "protectedBlocks"
        ],
        "properties": {
          "componentDocumentId": {
            "type": "string"
          },
          "fieldEnumerationStatus": {
            "type": "string"
          },
          "activeWritableFields": {
            "type": "array",
            "maxItems": 0
          },
          "manualParticipantBlocks": {
            "type": "array"
          },
          "protectedBlocks": {
            "type": "array"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
