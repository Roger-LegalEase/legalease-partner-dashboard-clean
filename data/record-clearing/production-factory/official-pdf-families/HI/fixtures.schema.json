{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rcap-hi-official-pdf-fixtures/v1",
  "title": "Hawaii HCJDC official PDF fail-closed fixture scaffold",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "familyId",
    "jurisdiction",
    "fixtureKind",
    "containsParticipantFactValues",
    "renderedSampleCount",
    "sampleArtifacts",
    "routeFixtures",
    "boundaryFixtures"
  ],
  "properties": {
    "schemaVersion": {
      "const": "rcap-official-pdf-fixtures/v1"
    },
    "familyId": {
      "const": "rcap-hi-official-pdf-family"
    },
    "jurisdiction": {
      "const": "HI"
    },
    "fixtureKind": {
      "const": "preflight_contract_only"
    },
    "containsParticipantFactValues": {
      "const": false
    },
    "renderedSampleCount": {
      "const": 0
    },
    "sampleArtifacts": {
      "type": "array",
      "maxItems": 0
    },
    "routeFixtures": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/routeFixture"
      }
    },
    "boundaryFixtures": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/boundaryFixture"
      }
    }
  },
  "$defs": {
    "routeFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureId",
        "trackId",
        "officialFormId",
        "componentId",
        "requiredFactKeys",
        "manualCompletionSemantics",
        "stageConstraint",
        "currentExpectedBlockers",
        "renderExpected"
      ],
      "properties": {
        "fixtureId": {
          "type": "string",
          "pattern": "^hi-"
        },
        "trackId": {
          "type": "string",
          "pattern": "^hi_"
        },
        "officialFormId": {
          "enum": [
            "HCJDC-159",
            "HCJDC-159B"
          ]
        },
        "componentId": {
          "type": "string",
          "pattern": "^hi_"
        },
        "requiredFactKeys": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "manualCompletionSemantics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stageConstraint": {
          "type": [
            "string",
            "null"
          ]
        },
        "currentExpectedBlockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "renderExpected": {
          "const": false
        }
      }
    },
    "boundaryFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureId",
        "kind",
        "expect"
      ],
      "properties": {
        "fixtureId": {
          "type": "string",
          "pattern": "^hi-"
        },
        "kind": {
          "enum": [
            "authority_unmanifested",
            "candidate_substitution_prohibited",
            "captain_assignment_required",
            "portable_projection_required",
            "private_path_read_prohibited",
            "legal_design_waiting_period",
            "conviction_stage_one_legal_design"
          ]
        },
        "expect": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
