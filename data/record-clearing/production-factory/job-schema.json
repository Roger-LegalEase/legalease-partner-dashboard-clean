{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalease.example/schemas/rcap-production-factory-job-v1.json",
  "title": "RCAP production factory job",
  "description": "A deterministic, path-bounded unit of nationwide record-clearing work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "parentJobId",
    "canonicalWave",
    "canonicalLane",
    "lane",
    "jurisdiction",
    "trackIds",
    "strategyFamily",
    "baseCommit",
    "dependencies",
    "ownedPaths",
    "integrationOwnedOutputs",
    "forbiddenPaths",
    "requiredInputs",
    "expectedOutputs",
    "requiredOutputFields",
    "focusedValidation",
    "integrationValidation",
    "model",
    "effort",
    "executionScope",
    "status",
    "commitSubject",
    "stopCondition"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "parentJobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
    },
    "canonicalWave": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "canonicalLane": {
      "enum": [
        "normalization",
        "authority",
        "platform",
        "implementation-pleading",
        "implementation-acroform",
        "implementation-overlay",
        "implementation-composed",
        "implementation-guidance",
        "proof",
        "counsel",
        "release"
      ]
    },
    "lane": {
      "enum": [
        "platform_foundation",
        "legal_design_normalization",
        "source_acquisition",
        "custom_pleading",
        "acroform_fill",
        "flat_pdf_overlay",
        "composed_route",
        "guidance_implementation",
        "legal_output_review",
        "staging_promotion"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^(?:[A-Z]{2}|NATIONWIDE)$"
    },
    "trackIds": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "strategyFamily": {
      "enum": [
        "platform_foundation",
        "legal_design",
        "source_acquisition",
        "in_repo_identity_reconciliation",
        "public_official_download",
        "official_download_automation_blocked",
        "direct_issuer_request",
        "commercial_license",
        "local_form_scope_correction",
        "source_identity_resolution",
        "not_required_design_reconciliation",
        "superseded_source_replacement",
        "edition_publication",
        "custom_pleading",
        "official_pdf_fill",
        "composed",
        "process_guidance",
        "legal_output_review",
        "staging_promotion"
      ]
    },
    "acquisitionIds": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "reconciliationIds": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "downloadedSourceCount": {
      "type": "integer",
      "minimum": 0
    },
    "regressionVerifier": {
      "$ref": "#/$defs/path"
    },
    "participantPacketProofRequired": {
      "type": "boolean"
    },
    "executionNote": {
      "type": "string",
      "minLength": 1
    },
    "sourceMaterializationInputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "expectedSha256",
          "expectedBytes",
          "canonicalAuthorityPath",
          "repositorySourcePath",
          "portableLocator",
          "materializationDestination",
          "authorityAssetState",
          "materializationState",
          "workerReadiness",
          "workerMayRead",
          "workerMayModify",
          "verificationCommand"
        ],
        "properties": {
          "documentId": { "type": "string", "minLength": 1 },
          "expectedSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expectedBytes": { "type": "integer", "minimum": 1 },
          "canonicalAuthorityPath": { "type": "string", "minLength": 1 },
          "repositorySourcePath": { "type": "string", "minLength": 1 },
          "portableLocator": { "type": "string", "minLength": 1 },
          "materializationDestination": { "$ref": "#/$defs/path" },
          "authorityAssetState": { "const": "authority_asset_known" },
          "materializationState": {
            "enum": [
              "binary_materialization_required",
              "binary_materialized_hash_verified"
            ]
          },
          "workerReadiness": {
            "enum": [
              "binary_materialization_required",
              "worker_ready"
            ]
          },
          "workerMayRead": { "const": true },
          "workerMayModify": { "const": false },
          "verificationCommand": { "type": "string", "minLength": 1 }
        }
      }
    },
    "normalizationReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityEdition",
        "readinessState",
        "controllingReviewAssetPath",
        "controllingReviewSha256",
        "controllingReviewStatus",
        "legalReviewPrecedence",
        "expectedSourceIds",
        "approvedMechanismInventory",
        "reviewedThrough",
        "openQuestions",
        "officialPrimaryAuthorityRefreshRequirements",
        "portableArchiveLocator"
      ],
      "properties": {
        "authorityEdition": { "type": "string", "minLength": 1 },
        "readinessState": {
          "enum": [
            "legal_review_materialization_required",
            "expected_source_id_set_required",
            "authority_archive_inconsistency",
            "ready_for_normalization"
          ]
        },
        "controllingReviewAssetPath": {
          "type": ["string", "null"]
        },
        "controllingReviewSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "controllingReviewStatus": {
          "enum": [
            "authority_absent",
            "authority_asset_known",
            "checksum_verified",
            "authority_archive_inconsistent"
          ]
        },
        "legalReviewPrecedence": { "type": "string", "minLength": 1 },
        "expectedSourceIds": { "$ref": "#/$defs/uniqueStrings" },
        "approvedMechanismInventory": {
          "type": ["object", "null"],
          "required": ["count", "sourcePath", "sourceSha256"],
          "properties": {
            "count": { "type": "integer", "minimum": 1 },
            "sourcePath": { "type": "string", "minLength": 1 },
            "sourceSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "reviewedThrough": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "openQuestions": { "$ref": "#/$defs/uniqueStrings" },
        "officialPrimaryAuthorityRefreshRequirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "officialUrl",
              "issuingDomain",
              "sectionIdentifier",
              "retrievalMethod",
              "retrievalDate",
              "capturedSourceSha256",
              "retrievalState",
              "alternateOfficialRetrievalChannel"
            ],
            "properties": {
              "officialUrl": { "type": "string", "minLength": 1 },
              "issuingDomain": { "type": "string", "minLength": 1 },
              "sectionIdentifier": { "type": "string", "minLength": 1 },
              "retrievalMethod": { "type": "string", "minLength": 1 },
              "retrievalDate": {
                "type": ["string", "null"],
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "capturedSourceSha256": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{64}$"
              },
              "retrievalState": {
                "enum": [
                  "shell_download_blocked",
                  "browser_official_retrieval_available",
                  "authority_absent",
                  "authority_archive_inconsistent"
                ]
              },
              "shellRetrievalState": {
                "const": "shell_download_blocked"
              },
              "alternateOfficialRetrievalChannel": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "portableArchiveLocator": { "type": "string", "minLength": 1 }
      }
    },
    "completionCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "ownedPaths": {
      "$ref": "#/$defs/nonemptyPaths"
    },
    "integrationOwnedOutputs": {
      "$ref": "#/$defs/nonemptyPaths"
    },
    "forbiddenPaths": {
      "$ref": "#/$defs/paths"
    },
    "requiredInputs": {
      "$ref": "#/$defs/paths"
    },
    "expectedOutputs": {
      "$ref": "#/$defs/nonemptyPaths"
    },
    "requiredOutputFields": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "focusedValidation": {
      "$ref": "#/$defs/commands"
    },
    "integrationValidation": {
      "$ref": "#/$defs/commands"
    },
    "model": {
      "enum": [
        "opus",
        "codex"
      ]
    },
    "effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "executionScope": {
      "enum": [
        "worker",
        "captain",
        "human"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "ready",
        "blocked",
        "in_progress",
        "completed",
        "cancelled"
      ]
    },
    "commitSubject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\r\\n]+$"
    },
    "stopCondition": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lane": {
            "const": "source_acquisition"
          },
          "strategyFamily": {
            "not": {
              "const": "edition_publication"
            }
          }
        },
        "required": [
          "lane",
          "strategyFamily"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "acquisitionIds"
            ],
            "properties": {
              "acquisitionIds": {
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "reconciliationIds"
            ],
            "properties": {
              "reconciliationIds": {
                "minItems": 1
              }
            }
          }
        ],
        "properties": {
          "requiredOutputFields": {
            "contains": {
              "const": "downloadedSourceCount"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "const": "source_acquisition"
          },
          "strategyFamily": {
            "not": {
              "const": "edition_publication"
            }
          },
          "acquisitionIds": {
            "minItems": 1
          }
        },
        "required": [
          "lane",
          "strategyFamily",
          "acquisitionIds"
        ]
      },
      "then": {
        "properties": {
          "requiredOutputFields": {
            "contains": {
              "const": "acquisitionIds"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "const": "source_acquisition"
          },
          "strategyFamily": {
            "not": {
              "const": "edition_publication"
            }
          },
          "reconciliationIds": {
            "minItems": 1
          }
        },
        "required": [
          "lane",
          "strategyFamily",
          "reconciliationIds"
        ]
      },
      "then": {
        "properties": {
          "requiredOutputFields": {
            "contains": {
              "const": "reconciliationIds"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "enum": [
              "custom_pleading",
              "acroform_fill",
              "flat_pdf_overlay",
              "composed_route",
              "guidance_implementation"
            ]
          }
        },
        "required": ["lane"]
      },
      "then": {
        "required": [
          "regressionVerifier",
          "participantPacketProofRequired"
        ],
        "properties": {
          "participantPacketProofRequired": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "strategyFamily": {
            "const": "official_pdf_fill"
          },
          "status": {
            "enum": ["planned", "ready", "blocked", "in_progress"]
          }
        },
        "required": ["strategyFamily", "status"]
      },
      "then": {
        "required": ["sourceMaterializationInputs"]
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "const": "legal_design_normalization"
          },
          "jobId": {
            "pattern": "-legal-design-normalization$"
          }
        },
        "required": ["lane", "jobId"]
      },
      "then": {
        "required": ["normalizationReadiness"]
      }
    }
  ],
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?\\[\\]{}!]).+$"
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "nonemptyPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
