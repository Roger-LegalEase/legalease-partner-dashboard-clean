{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalease.example/schemas/rcap-production-factory-job-v1.json",
  "title": "RCAP production factory job",
  "description": "A deterministic, path-bounded unit of nationwide record-clearing work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "parentJobId",
    "canonicalWave",
    "canonicalLane",
    "lane",
    "jurisdiction",
    "trackIds",
    "strategyFamily",
    "baseCommit",
    "dependencies",
    "ownedPaths",
    "integrationOwnedOutputs",
    "forbiddenPaths",
    "requiredInputs",
    "expectedOutputs",
    "requiredOutputFields",
    "focusedValidation",
    "integrationValidation",
    "model",
    "effort",
    "executionScope",
    "status",
    "commitSubject",
    "stopCondition"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "parentJobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
    },
    "canonicalWave": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "canonicalLane": {
      "enum": [
        "normalization",
        "authority",
        "platform",
        "implementation-pleading",
        "implementation-acroform",
        "implementation-overlay",
        "implementation-composed",
        "implementation-guidance",
        "proof",
        "counsel",
        "release"
      ]
    },
    "lane": {
      "enum": [
        "platform_foundation",
        "legal_design_normalization",
        "source_acquisition",
        "custom_pleading",
        "acroform_fill",
        "flat_pdf_overlay",
        "composed_route",
        "guidance_implementation",
        "legal_output_review",
        "staging_promotion"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^(?:[A-Z]{2}|NATIONWIDE)$"
    },
    "trackIds": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "strategyFamily": {
      "enum": [
        "platform_foundation",
        "legal_design",
        "source_acquisition",
        "in_repo_identity_reconciliation",
        "public_official_download",
        "official_download_automation_blocked",
        "direct_issuer_request",
        "commercial_license",
        "local_form_scope_correction",
        "source_identity_resolution",
        "not_required_design_reconciliation",
        "superseded_source_replacement",
        "edition_publication",
        "custom_pleading",
        "official_pdf_fill",
        "composed",
        "process_guidance",
        "legal_output_review",
        "staging_promotion"
      ]
    },
    "acquisitionIds": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "reconciliationIds": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "downloadedSourceCount": {
      "type": "integer",
      "minimum": 0
    },
    "regressionVerifier": {
      "$ref": "#/$defs/path"
    },
    "participantPacketProofRequired": {
      "type": "boolean"
    },
    "executionNote": {
      "type": "string",
      "minLength": 1
    },
    "sourceMaterializationInputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "expectedSha256",
          "expectedBytes",
          "canonicalAuthorityPath",
          "repositorySourcePath",
          "portableLocator",
          "materializationDestination",
          "authorityAssetState",
          "materializationState",
          "workerReadiness",
          "workerMayRead",
          "workerMayModify",
          "verificationCommand"
        ],
        "properties": {
          "documentId": { "type": "string", "minLength": 1 },
          "expectedSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expectedBytes": { "type": "integer", "minimum": 1 },
          "canonicalAuthorityPath": { "type": "string", "minLength": 1 },
          "repositorySourcePath": { "type": "string", "minLength": 1 },
          "portableLocator": { "type": "string", "minLength": 1 },
          "materializationDestination": { "$ref": "#/$defs/path" },
          "authorityAssetState": { "const": "authority_asset_known" },
          "materializationState": {
            "enum": [
              "binary_materialization_required",
              "binary_materialized_hash_verified"
            ]
          },
          "workerReadiness": {
            "enum": [
              "binary_materialization_required",
              "worker_ready"
            ]
          },
          "workerMayRead": { "const": true },
          "workerMayModify": { "const": false },
          "verificationCommand": { "type": "string", "minLength": 1 }
        }
      }
    },
    "normalizationReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "authorityEdition",
        "jurisdiction",
        "controllingReviewAssetPath",
        "controllingReviewSha256",
        "controllingReviewStatus",
        "controllingReviewRevision",
        "reviewedThrough",
        "legalReviewPrecedence",
        "precedenceStatus",
        "mechanismInventory",
        "mechanismInventorySha256",
        "expectedSourceIds",
        "retainedForms",
        "openQuestions",
        "officialAuthorityRefreshRequirements",
        "officialAuthorityRefreshStatus",
        "retrievalMethods",
        "reviewMaterialization",
        "portableArchiveLocator",
        "readinessState",
        "readinessBlockers"
      ],
      "properties": {
        "schemaVersion": {
          "const": "rcap-normalization-readiness-record/v1"
        },
        "authorityEdition": { "type": "string", "minLength": 1 },
        "jurisdiction": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "readinessState": {
          "enum": [
            "legal_review_materialization_required",
            "legal_review_hash_mismatch",
            "mechanism_inventory_required",
            "mechanism_inventory_hash_mismatch",
            "expected_source_ids_required",
            "official_authority_refresh_required",
            "ready_for_normalization",
            "normalization_in_progress",
            "normalization_complete"
          ]
        },
        "controllingReviewAssetPath": {
          "type": "string",
          "minLength": 1
        },
        "controllingReviewSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "controllingReviewStatus": {
          "enum": [
            "authority_asset_known",
            "checksum_verified",
            "legal_review_hash_mismatch",
            "authority_archive_inconsistent"
          ]
        },
        "controllingReviewRevision": {
          "type": "string",
          "pattern": "^ASOF-\\d{4}-\\d{2}-\\d{2}$"
        },
        "reviewedThrough": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "legalReviewPrecedence": { "type": "string", "minLength": 1 },
        "precedenceStatus": { "const": "resolved" },
        "mechanismInventory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "reviewSlot",
              "legalMechanismName",
              "classification",
              "candidateFilingActor",
              "candidateDestination",
              "referencedStatutesOrRules",
              "referencedOfficialForms",
              "unresolvedQuestions"
            ],
            "properties": {
              "sourceId": { "type": "string", "minLength": 1 },
              "reviewSlot": { "type": "string", "minLength": 1 },
              "legalMechanismName": { "type": "string", "minLength": 1 },
              "classification": {
                "enum": ["relief", "non_relief"]
              },
              "candidateFilingActor": {
                "type": "string",
                "minLength": 1
              },
              "candidateDestination": {
                "type": "string",
                "minLength": 1
              },
              "referencedStatutesOrRules": {
                "$ref": "#/$defs/uniqueStrings"
              },
              "referencedOfficialForms": {
                "$ref": "#/$defs/uniqueStrings"
              },
              "unresolvedQuestions": {
                "$ref": "#/$defs/uniqueStrings"
              }
            }
          }
        },
        "mechanismInventorySha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "expectedSourceIds": { "$ref": "#/$defs/uniqueStrings" },
        "retainedForms": { "$ref": "#/$defs/uniqueStrings" },
        "openQuestions": { "$ref": "#/$defs/uniqueStrings" },
        "officialAuthorityRefreshRequirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "officialUrl",
              "issuingDomain",
              "sectionIdentifier",
              "retrievalMethod",
              "retrievalDate",
              "capturedSourceSha256",
              "retrievalState",
              "alternateOfficialRetrievalChannel"
            ],
            "properties": {
              "officialUrl": { "type": "string", "minLength": 1 },
              "issuingDomain": { "type": "string", "minLength": 1 },
              "sectionIdentifier": { "type": "string", "minLength": 1 },
              "retrievalMethod": { "type": "string", "minLength": 1 },
              "retrievalDate": {
                "type": ["string", "null"],
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "capturedSourceSha256": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{64}$"
              },
              "retrievalState": {
                "enum": [
                  "shell_download_blocked",
                  "browser_official_retrieval_available",
                  "authority_absent",
                  "authority_archive_inconsistent",
                  "official_authority_hash_verified"
                ]
              },
              "shellRetrievalState": {
                "const": "shell_download_blocked"
              },
              "alternateOfficialRetrievalChannel": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "officialAuthorityRefreshStatus": {
          "enum": ["required", "recorded"]
        },
        "retrievalMethods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "locator",
              "issuingDomain",
              "status",
              "alternateOfficialRetrievalChannel"
            ],
            "properties": {
              "method": { "type": "string", "minLength": 1 },
              "locator": { "type": "string", "minLength": 1 },
              "issuingDomain": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 },
              "alternateOfficialRetrievalChannel": {
                "type": ["string", "null"],
                "minLength": 1
              }
            }
          }
        },
        "reviewMaterialization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "archiveLocator",
            "archiveSha256",
            "archiveEntryPath",
            "expectedSha256",
            "materializationDestination",
            "materializationState",
            "readOnly",
            "verificationCommand",
            "verificationProvenance"
          ],
          "properties": {
            "archiveLocator": { "type": "string", "minLength": 1 },
            "archiveSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "archiveEntryPath": { "type": "string", "minLength": 1 },
            "expectedSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "observedSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "materializationDestination": { "$ref": "#/$defs/path" },
            "materializationState": {
              "enum": [
                "binary_materialization_required",
                "binary_hash_verified",
                "binary_hash_mismatch",
                "binary_unavailable"
              ]
            },
            "readOnly": { "const": true },
            "verificationCommand": { "type": "string", "minLength": 1 },
            "verificationProvenance": { "type": "string", "minLength": 1 }
          }
        },
        "portableArchiveLocator": { "type": "string", "minLength": 1 },
        "readinessBlockers": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "assignmentClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetType",
        "jobId",
        "jurisdiction",
        "ownerSession",
        "status"
      ],
      "properties": {
        "targetType": { "const": "compiled_job" },
        "jobId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^(?:[A-Z]{2}|NATIONWIDE)$"
        },
        "ownerSession": {
          "enum": ["SESSION_B", "SESSION_C", "SESSION_D", "SESSION_F"]
        },
        "status": {
          "enum": ["reserved", "in_progress"]
        }
      }
    },
    "completionCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "ownedPaths": {
      "$ref": "#/$defs/nonemptyPaths"
    },
    "integrationOwnedOutputs": {
      "$ref": "#/$defs/nonemptyPaths"
    },
    "forbiddenPaths": {
      "$ref": "#/$defs/paths"
    },
    "requiredInputs": {
      "$ref": "#/$defs/paths"
    },
    "expectedOutputs": {
      "$ref": "#/$defs/nonemptyPaths"
    },
    "requiredOutputFields": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "focusedValidation": {
      "$ref": "#/$defs/commands"
    },
    "integrationValidation": {
      "$ref": "#/$defs/commands"
    },
    "model": {
      "enum": [
        "opus",
        "codex"
      ]
    },
    "effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "executionScope": {
      "enum": [
        "worker",
        "captain",
        "human"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "ready",
        "blocked",
        "in_progress",
        "completed",
        "cancelled"
      ]
    },
    "commitSubject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\r\\n]+$"
    },
    "stopCondition": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lane": {
            "const": "source_acquisition"
          },
          "strategyFamily": {
            "not": {
              "const": "edition_publication"
            }
          }
        },
        "required": [
          "lane",
          "strategyFamily"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "acquisitionIds"
            ],
            "properties": {
              "acquisitionIds": {
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "reconciliationIds"
            ],
            "properties": {
              "reconciliationIds": {
                "minItems": 1
              }
            }
          }
        ],
        "properties": {
          "requiredOutputFields": {
            "contains": {
              "const": "downloadedSourceCount"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "const": "source_acquisition"
          },
          "strategyFamily": {
            "not": {
              "const": "edition_publication"
            }
          },
          "acquisitionIds": {
            "minItems": 1
          }
        },
        "required": [
          "lane",
          "strategyFamily",
          "acquisitionIds"
        ]
      },
      "then": {
        "properties": {
          "requiredOutputFields": {
            "contains": {
              "const": "acquisitionIds"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "const": "source_acquisition"
          },
          "strategyFamily": {
            "not": {
              "const": "edition_publication"
            }
          },
          "reconciliationIds": {
            "minItems": 1
          }
        },
        "required": [
          "lane",
          "strategyFamily",
          "reconciliationIds"
        ]
      },
      "then": {
        "properties": {
          "requiredOutputFields": {
            "contains": {
              "const": "reconciliationIds"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "enum": [
              "custom_pleading",
              "acroform_fill",
              "flat_pdf_overlay",
              "composed_route",
              "guidance_implementation"
            ]
          }
        },
        "required": ["lane"]
      },
      "then": {
        "required": [
          "regressionVerifier",
          "participantPacketProofRequired"
        ],
        "properties": {
          "participantPacketProofRequired": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "strategyFamily": {
            "const": "official_pdf_fill"
          },
          "status": {
            "enum": ["planned", "ready", "blocked", "in_progress"]
          }
        },
        "required": ["strategyFamily", "status"]
      },
      "then": {
        "required": ["sourceMaterializationInputs"]
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "const": "legal_design_normalization"
          },
          "jobId": {
            "pattern": "-legal-design-normalization$"
          }
        },
        "required": ["lane", "jobId"]
      },
      "then": {
        "required": ["normalizationReadiness"]
      }
    }
  ],
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?\\[\\]{}!]).+$"
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "nonemptyPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
