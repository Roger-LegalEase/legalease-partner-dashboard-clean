{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalease.example/schemas/rcap-production-factory-job-v1.json",
  "title": "RCAP production factory job",
  "description": "A deterministic, path-bounded unit of nationwide record-clearing work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "parentJobId",
    "canonicalWave",
    "canonicalLane",
    "lane",
    "jurisdiction",
    "trackIds",
    "strategyFamily",
    "baseCommit",
    "dependencies",
    "ownedPaths",
    "integrationOwnedOutputs",
    "forbiddenPaths",
    "requiredInputs",
    "expectedOutputs",
    "requiredOutputFields",
    "focusedValidation",
    "integrationValidation",
    "model",
    "effort",
    "executionScope",
    "status",
    "commitSubject",
    "stopCondition"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "parentJobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
    },
    "canonicalWave": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "canonicalLane": {
      "enum": [
        "normalization",
        "authority",
        "platform",
        "implementation-pleading",
        "implementation-acroform",
        "implementation-overlay",
        "implementation-composed",
        "implementation-guidance",
        "proof",
        "counsel",
        "release"
      ]
    },
    "lane": {
      "enum": [
        "platform_foundation",
        "legal_design_normalization",
        "source_acquisition",
        "custom_pleading",
        "acroform_fill",
        "flat_pdf_overlay",
        "composed_route",
        "guidance_implementation",
        "legal_output_review",
        "staging_promotion"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^(?:[A-Z]{2}|NATIONWIDE)$"
    },
    "trackIds": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "strategyFamily": {
      "enum": [
        "platform_foundation",
        "normalization_readiness",
        "legal_review_materialization",
        "legal_design",
        "source_acquisition",
        "in_repo_identity_reconciliation",
        "public_official_download",
        "official_download_automation_blocked",
        "direct_issuer_request",
        "commercial_license",
        "local_form_scope_correction",
        "source_identity_resolution",
        "not_required_design_reconciliation",
        "superseded_source_replacement",
        "edition_publication",
        "legal_design_adjudication",
        "custom_pleading",
        "official_pdf_fill",
        "composed",
        "process_guidance",
        "legal_output_review",
        "staging_promotion"
      ]
    },
    "acquisitionIds": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "reconciliationIds": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "downloadedSourceCount": {
      "type": "integer",
      "minimum": 0
    },
    "regressionVerifier": {
      "$ref": "#/$defs/path"
    },
    "participantPacketProofRequired": {
      "type": "boolean"
    },
    "executionNote": {
      "type": "string",
      "minLength": 1
    },
    "sourceMaterializationInputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceIdentityKey",
          "documentId",
          "authorityEdition",
          "authorityArchiveSha256",
          "jurisdiction",
          "documentRole",
          "expectedMediaType",
          "expectedSha256",
          "expectedBytes",
          "canonicalAuthorityPath",
          "repositorySourcePath",
          "portableLocator",
          "materializationDestination",
          "authorityAssetState",
          "materializationState",
          "workerReadiness",
          "workerMayRead",
          "workerMayModify",
          "verificationCommand",
          "readOnlyTreatment",
          "retentionPolicy",
          "expectedMeasurementBasis",
          "identityBindingStatus",
          "registryState",
          "usageBindings",
          "provenance"
        ],
        "properties": {
          "sourceIdentityKey": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "documentId": { "type": "string", "minLength": 1 },
          "authorityEdition": { "type": "string", "minLength": 1 },
          "authorityArchiveSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "jurisdiction": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "documentRole": { "type": "string", "minLength": 1 },
          "expectedMediaType": { "const": "application/pdf" },
          "expectedSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expectedBytes": { "type": "integer", "minimum": 1 },
          "canonicalAuthorityPath": { "type": "string", "minLength": 1 },
          "repositorySourcePath": { "type": "string", "minLength": 1 },
          "portableLocator": { "type": "string", "minLength": 1 },
          "materializationDestination": { "$ref": "#/$defs/path" },
          "authorityAssetState": { "const": "authority_asset_known" },
          "materializationState": {
            "enum": [
              "binary_materialization_required",
              "binary_materialized_hash_verified"
            ]
          },
          "workerReadiness": {
            "enum": [
              "binary_materialization_required",
              "worker_ready"
            ]
          },
          "workerMayRead": { "const": true },
          "workerMayModify": { "const": false },
          "verificationCommand": { "type": "string", "minLength": 1 },
          "readOnlyTreatment": { "const": "worker_read_only_no_modify" },
          "retentionPolicy": { "type": "string", "minLength": 1 },
          "expectedMeasurementBasis": { "type": "string", "minLength": 1 },
          "identityBindingStatus": { "const": "exact_pinned_identity" },
          "registryState": { "const": "registry_metadata_present" },
          "usageBindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["trackId", "componentId"],
              "properties": {
                "trackId": { "type": "string", "minLength": 1 },
                "componentId": { "type": ["string", "null"] }
              }
            }
          },
          "provenance": { "type": "object" }
        }
      }
    },
    "legalReviewMaterializationAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "jurisdiction",
        "ownerSession",
        "canonicalParent",
        "activeReview",
        "receiptOutput",
        "expectedActiveReviewCount",
        "expectedAddendumCount",
        "downstreamDependentJobs",
        "focusedVerifier",
        "verificationCommand",
        "ownedPaths",
        "assignmentClaim",
        "stopCondition",
        "currentStatus"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "ownerSession": {
          "enum": ["SESSION_B", "SESSION_D"]
        },
        "canonicalParent": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "activeReview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "documentId",
            "expectedTitle",
            "expectedSha256",
            "expectedBytes",
            "expectedMime",
            "authorityEdition",
            "revision",
            "sourceArchiveIdentity",
            "expectedArchiveSha256",
            "expectedArchiveBytes",
            "portableArchiveLocator",
            "portableSourceLocator",
            "archiveRelativePath",
            "materializationDestination"
          ],
          "properties": {
            "documentId": { "const": "STATEWIDE" },
            "expectedTitle": { "type": "string", "minLength": 1 },
            "expectedSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "expectedBytes": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "expectedMime": { "const": "text/markdown" },
            "authorityEdition": { "type": "string", "minLength": 1 },
            "revision": {
              "type": "string",
              "pattern": "^ASOF-\\d{4}-\\d{2}-\\d{2}$"
            },
            "sourceArchiveIdentity": { "type": "string", "minLength": 1 },
            "expectedArchiveSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "expectedArchiveBytes": { "type": "integer", "minimum": 1 },
            "portableArchiveLocator": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9+.-]*://[^/].+"
            },
            "portableSourceLocator": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9+.-]*://[^/].+"
            },
            "archiveRelativePath": { "$ref": "#/$defs/path" },
            "materializationDestination": { "$ref": "#/$defs/path" }
          }
        },
        "receiptOutput": { "$ref": "#/$defs/path" },
        "expectedActiveReviewCount": { "const": 1 },
        "expectedAddendumCount": { "const": 0 },
        "downstreamDependentJobs": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "focusedVerifier": { "$ref": "#/$defs/path" },
        "verificationCommand": { "type": "string", "minLength": 1 },
        "ownedPaths": { "$ref": "#/$defs/nonemptyPaths" },
        "assignmentClaim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetType",
            "jobId",
            "jurisdiction",
            "ownerSession",
            "status"
          ],
          "properties": {
            "targetType": { "const": "compiled_job" },
            "jobId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "jurisdiction": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "ownerSession": {
              "enum": ["SESSION_B", "SESSION_D"]
            },
            "status": { "const": "reserved" }
          }
        },
        "stopCondition": { "type": "string", "minLength": 1 },
        "currentStatus": {
          "const": "blocked_external_archive_and_verified_receipt_required"
        }
      }
    },
    "officialPdfAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectionPath",
        "projectionSha256",
        "assignmentState",
        "identityKeys",
        "newImplementationIdentityKeys",
        "existingImplementationMaterializationOnlyIdentityKeys",
        "documentIds",
        "exactTrackIds",
        "exactComponentIds",
        "componentUses",
        "implementationFamilies",
        "fieldOwnershipScaffolds",
        "legalDesignDependencies",
        "materializationDependencies",
        "unresolvedOrTerminalIdentities",
        "expectedOutputs",
        "ownedPaths",
        "focusedVerifier",
        "runtimeDisabledInvariant",
        "workerMayAcquireOrMaterializeSources",
        "assignmentBlockers"
      ],
      "properties": {
        "schemaVersion": {
          "const": "rcap-official-pdf-child-assignment/v1"
        },
        "projectionPath": { "$ref": "#/$defs/path" },
        "projectionSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "assignmentState": {
          "enum": [
            "exact_pinned_assignment_blocked_external_materialization",
            "exact_pinned_assignment_worker_ready",
            "blocked_no_exact_identity_assignment"
          ]
        },
        "identityKeys": { "$ref": "#/$defs/uniqueStrings" },
        "newImplementationIdentityKeys": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "existingImplementationMaterializationOnlyIdentityKeys": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "documentIds": { "$ref": "#/$defs/uniqueStrings" },
        "exactTrackIds": { "$ref": "#/$defs/uniqueStrings" },
        "exactComponentIds": { "$ref": "#/$defs/uniqueStrings" },
        "componentUses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identityKey",
              "trackId",
              "componentId",
              "role",
              "requirement",
              "conditionDescription"
            ],
            "properties": {
              "identityKey": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "trackId": { "type": "string", "minLength": 1 },
              "componentId": { "type": ["string", "null"] },
              "role": { "type": ["string", "null"] },
              "requirement": { "type": ["string", "null"] },
              "conditionDescription": { "type": ["string", "null"] }
            }
          }
        },
        "implementationFamilies": { "$ref": "#/$defs/uniqueStrings" },
        "fieldOwnershipScaffolds": { "$ref": "#/$defs/paths" },
        "legalDesignDependencies": { "$ref": "#/$defs/uniqueStrings" },
        "materializationDependencies": { "$ref": "#/$defs/uniqueStrings" },
        "unresolvedOrTerminalIdentities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identityKey", "disposition"],
            "properties": {
              "identityKey": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "disposition": { "type": "string", "minLength": 1 }
            }
          }
        },
        "expectedOutputs": { "$ref": "#/$defs/paths" },
        "ownedPaths": { "$ref": "#/$defs/paths" },
        "focusedVerifier": { "$ref": "#/$defs/path" },
        "runtimeDisabledInvariant": { "const": true },
        "workerMayAcquireOrMaterializeSources": { "const": false },
        "assignmentBlockers": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "officialPdfConsumerDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identityKey", "ownerJobId", "componentUses"],
        "properties": {
          "identityKey": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "ownerJobId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "componentUses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "trackId",
                "componentId",
                "role",
                "requirement",
                "conditionDescription"
              ],
              "properties": {
                "trackId": { "type": "string", "minLength": 1 },
                "componentId": { "type": ["string", "null"] },
                "role": { "type": ["string", "null"] },
                "requirement": { "type": ["string", "null"] },
                "conditionDescription": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    "normalizationReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "authorityEdition",
        "jurisdiction",
        "controllingReviewAssetPath",
        "controllingReviewSha256",
        "controllingReviewStatus",
        "controllingReviewRevision",
        "reviewedThrough",
        "reviewDateEvidence",
        "legalReviewPrecedence",
        "precedenceStatus",
        "mechanismInventory",
        "mechanismInventorySha256",
        "canonicalizationVersion",
        "researchSuppliedInventorySha256",
        "canonicalMechanismInventorySha256",
        "canonicalPayloadByteCount",
        "denominatorAdjudication",
        "expectedSourceIds",
        "retainedForms",
        "retainedFormAvailability",
        "openQuestions",
        "officialAuthorityRefreshRequirements",
        "officialAuthorityRefreshStatus",
        "authorityRefreshFlags",
        "retrievalMethods",
        "reviewMaterialization",
        "portableArchiveLocator",
        "readinessState",
        "readinessBlockers"
      ],
      "properties": {
        "schemaVersion": {
          "const": "rcap-normalization-readiness-record/v1"
        },
        "authorityEdition": { "type": "string", "minLength": 1 },
        "jurisdiction": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "readinessState": {
          "enum": [
            "mechanism_count_counsel_addendum_required",
            "reviewed_through_librarian_correction_required",
            "codification_authority_unverified",
            "legal_review_materialization_required",
            "legal_review_hash_mismatch",
            "mechanism_inventory_count_conflict",
            "mechanism_inventory_required",
            "mechanism_inventory_hash_mismatch",
            "expected_source_ids_required",
            "official_authority_refresh_required",
            "ready_for_normalization",
            "normalization_in_progress",
            "normalization_complete"
          ]
        },
        "controllingReviewAssetPath": {
          "type": "string",
          "minLength": 1
        },
        "controllingReviewSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "controllingReviewStatus": {
          "enum": [
            "authority_asset_known",
            "checksum_verified",
            "legal_review_hash_mismatch",
            "authority_archive_inconsistent"
          ]
        },
        "controllingReviewRevision": {
          "type": "string",
          "pattern": "^ASOF-\\d{4}-\\d{2}-\\d{2}$"
        },
        "reviewedThrough": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "reviewDateEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filenameAsOf", "internalReviewDate", "status"],
          "properties": {
            "filenameAsOf": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "internalReviewDate": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "status": { "enum": ["reconciled", "conflict"] }
          }
        },
        "legalReviewPrecedence": { "type": "string", "minLength": 1 },
        "precedenceStatus": { "const": "resolved" },
        "mechanismInventory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sourceId"],
            "properties": {
              "sourceId": { "type": "string", "minLength": 1 }
            }
          }
        },
        "mechanismInventorySha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "canonicalizationVersion": {
          "const": "mechanism-inventory-v1"
        },
        "researchSuppliedInventorySha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "canonicalMechanismInventorySha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "canonicalPayloadByteCount": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "denominatorAdjudication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reviewSummaryCount",
            "keyedBodyCount",
            "resolution",
            "unresolvedQuestion"
          ],
          "properties": {
            "status": {
              "enum": [
                "mechanism_inventory_required",
                "keyed_denominator_reconciled",
                "count_conflict_unresolved"
              ]
            },
            "reviewSummaryCount": { "type": ["integer", "null"], "minimum": 0 },
            "keyedBodyCount": { "type": ["integer", "null"], "minimum": 0 },
            "resolution": { "type": ["string", "null"], "minLength": 1 },
            "unresolvedQuestion": {
              "type": ["string", "null"],
              "minLength": 1
            }
          }
        },
        "adjudicationEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "session",
            "sourceCommit",
            "parentResearchCommit",
            "adjudicationPath",
            "adjudicationSha256",
            "manifestPath",
            "manifestSha256",
            "workerDeclaredReadinessRecordChanged",
            "originalBundleChanged",
            "productionEffect",
            "adoptionEffect",
            "resultStatus"
          ],
          "properties": {
            "schemaVersion": {
              "const": "rcap-normalization-readiness-adjudication-evidence/v1"
            },
            "session": { "const": "SESSION_D" },
            "sourceCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "parentResearchCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "adjudicationPath": { "$ref": "#/$defs/path" },
            "adjudicationSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "manifestPath": { "$ref": "#/$defs/path" },
            "manifestSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "workerDeclaredReadinessRecordChanged": { "type": "boolean" },
            "originalBundleChanged": { "const": false },
            "productionEffect": { "const": "none" },
            "adoptionEffect": { "type": "string", "minLength": 1 },
            "sourceMapField": { "type": "string", "minLength": 1 },
            "resultStatus": { "type": "string", "minLength": 1 }
          }
        },
        "counselStructureAdoption": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "adoptionDate",
            "adoptedBy",
            "adoptionPath",
            "adoptionSha256",
            "manifestPath",
            "manifestSha256",
            "parentAdjudicationSha256",
            "authoritativeSourceSlots",
            "authoritativeSubstantiveReliefTracks",
            "authoritativeNormalizedNodes",
            "crosswalkDispositionCount",
            "revisedSummary",
            "closedBlockers",
            "preservedBlockers",
            "structureOnly",
            "normalizationExecutionAuthorized",
            "runtimeEffect",
            "productionEffect"
          ],
          "properties": {
            "schemaVersion": {
              "const": "rcap-normalization-structure-counsel-adoption-evidence/v1"
            },
            "adoptionDate": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "adoptedBy": { "const": "counsel" },
            "adoptionPath": { "$ref": "#/$defs/path" },
            "adoptionSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "manifestPath": { "$ref": "#/$defs/path" },
            "manifestSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "parentAdjudicationSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "authoritativeSourceSlots": { "type": "integer", "minimum": 1 },
            "authoritativeSubstantiveReliefTracks": {
              "type": "integer",
              "minimum": 1
            },
            "authoritativeNormalizedNodes": {
              "type": "integer",
              "minimum": 1
            },
            "crosswalkDispositionCount": {
              "type": "integer",
              "minimum": 1
            },
            "revisedSummary": { "type": "string", "minLength": 1 },
            "closedBlockers": { "$ref": "#/$defs/uniqueStrings" },
            "preservedBlockers": { "$ref": "#/$defs/uniqueStrings" },
            "structureOnly": { "const": true },
            "normalizationExecutionAuthorized": { "const": false },
            "runtimeEffect": { "const": "none" },
            "productionEffect": { "const": "none" },
            "reviewedThrough": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "packagingDate": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "expectedSourceIds": { "$ref": "#/$defs/uniqueStrings" },
        "retainedForms": { "$ref": "#/$defs/uniqueStrings" },
        "retainedFormAvailability": { "type": "string", "minLength": 1 },
        "openQuestions": { "$ref": "#/$defs/uniqueStrings" },
        "authorityRefreshFlags": { "$ref": "#/$defs/uniqueStrings" },
        "officialAuthorityRefreshRequirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "officialUrl",
              "issuingDomain",
              "sectionIdentifier",
              "retrievalMethod",
              "retrievalDate",
              "capturedSourceSha256",
              "retrievalState",
              "alternateOfficialRetrievalChannel"
            ],
            "properties": {
              "officialUrl": {
                "type": ["string", "null"],
                "minLength": 1
              },
              "issuingDomain": {
                "type": ["string", "null"],
                "minLength": 1
              },
              "sectionIdentifier": { "type": "string", "minLength": 1 },
              "retrievalMethod": { "type": "string", "minLength": 1 },
              "retrievalDate": {
                "type": ["string", "null"],
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "capturedSourceSha256": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{64}$"
              },
              "retrievalState": {
                "enum": [
                  "shell_accessible",
                  "browser_accessible",
                  "automation_blocked",
                  "unofficial_reference_only",
                  "unavailable",
                  "shell_download_blocked",
                  "browser_official_retrieval_available",
                  "adjudication_verified_identity",
                  "authority_absent",
                  "authority_archive_inconsistent",
                  "official_authority_hash_verified"
                ]
              },
              "shellRetrievalState": {
                "const": "shell_download_blocked"
              },
              "alternateOfficialRetrievalChannel": {
                "type": "string",
                "minLength": 1
              },
              "adjudicatedStatus": { "type": "string", "minLength": 1 },
              "materialCorrection": { "type": "string", "minLength": 1 },
              "participantGenerationTarget": { "const": false }
            }
          }
        },
        "officialAuthorityRefreshStatus": {
          "enum": ["required", "recorded"]
        },
        "retrievalMethods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "locator",
              "issuingDomain",
              "status",
              "alternateOfficialRetrievalChannel"
            ],
            "properties": {
              "method": { "type": "string", "minLength": 1 },
              "locator": { "type": "string", "minLength": 1 },
              "issuingDomain": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 },
              "alternateOfficialRetrievalChannel": {
                "type": ["string", "null"],
                "minLength": 1
              }
            }
          }
        },
        "reviewMaterialization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "archiveLocator",
            "archiveSha256",
            "archiveEntryPath",
            "expectedSha256",
            "expectedBytes",
            "observedSha256",
            "observedBytes",
            "materializationMethod",
            "materializationDestination",
            "materializationState",
            "readOnly",
            "readOnlyTreatment",
            "verificationCommand",
            "verificationProvenance",
            "researchVerificationResult",
            "verificationStatus",
            "cleanupPolicy"
          ],
          "properties": {
            "archiveLocator": { "type": "string", "minLength": 1 },
            "archiveSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "archiveEntryPath": { "type": "string", "minLength": 1 },
            "expectedSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "expectedBytes": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "observedSha256": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-f]{64}$"
            },
            "observedBytes": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "materializationMethod": {
              "const": "portable_archive_entry"
            },
            "materializationDestination": { "$ref": "#/$defs/path" },
            "materializationState": {
              "enum": [
                "binary_materialization_required",
                "binary_hash_verified",
                "binary_hash_mismatch",
                "binary_unavailable"
              ]
            },
            "readOnly": { "const": true },
            "readOnlyTreatment": {
              "const": "worker_read_only_no_modify"
            },
            "verificationCommand": { "type": "string", "minLength": 1 },
            "verificationProvenance": { "type": "string", "minLength": 1 },
            "researchVerificationResult": {
              "type": "string",
              "minLength": 1
            },
            "verificationStatus": { "type": "string", "minLength": 1 },
            "cleanupPolicy": { "type": "string", "minLength": 1 }
          }
        },
        "portableArchiveLocator": { "type": "string", "minLength": 1 },
        "readinessBlockers": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "assignmentClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetType",
        "jobId",
        "jurisdiction",
        "ownerSession",
        "status"
      ],
      "properties": {
        "targetType": { "const": "compiled_job" },
        "jobId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^(?:[A-Z]{2}|NATIONWIDE)$"
        },
        "ownerSession": {
          "enum": ["SESSION_B", "SESSION_C", "SESSION_D", "SESSION_E", "SESSION_F"]
        },
        "status": {
          "enum": ["reserved", "in_progress"]
        }
      }
    },
    "completionCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "ownedPaths": {
      "$ref": "#/$defs/nonemptyPaths"
    },
    "integrationOwnedOutputs": {
      "$ref": "#/$defs/nonemptyPaths"
    },
    "forbiddenPaths": {
      "$ref": "#/$defs/paths"
    },
    "requiredInputs": {
      "$ref": "#/$defs/paths"
    },
    "expectedOutputs": {
      "$ref": "#/$defs/nonemptyPaths"
    },
    "requiredOutputFields": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "focusedValidation": {
      "$ref": "#/$defs/commands"
    },
    "integrationValidation": {
      "$ref": "#/$defs/commands"
    },
    "model": {
      "enum": [
        "opus",
        "codex"
      ]
    },
    "effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "executionScope": {
      "enum": [
        "worker",
        "captain",
        "human"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "ready",
        "blocked",
        "in_progress",
        "completed",
        "cancelled"
      ]
    },
    "commitSubject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\r\\n]+$"
    },
    "stopCondition": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lane": {
            "const": "source_acquisition"
          },
          "strategyFamily": {
            "not": {
              "const": "edition_publication"
            }
          }
        },
        "required": [
          "lane",
          "strategyFamily"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "acquisitionIds"
            ],
            "properties": {
              "acquisitionIds": {
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "reconciliationIds"
            ],
            "properties": {
              "reconciliationIds": {
                "minItems": 1
              }
            }
          }
        ],
        "properties": {
          "requiredOutputFields": {
            "contains": {
              "const": "downloadedSourceCount"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "const": "source_acquisition"
          },
          "strategyFamily": {
            "not": {
              "const": "edition_publication"
            }
          },
          "acquisitionIds": {
            "minItems": 1
          }
        },
        "required": [
          "lane",
          "strategyFamily",
          "acquisitionIds"
        ]
      },
      "then": {
        "properties": {
          "requiredOutputFields": {
            "contains": {
              "const": "acquisitionIds"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "const": "source_acquisition"
          },
          "strategyFamily": {
            "not": {
              "const": "edition_publication"
            }
          },
          "reconciliationIds": {
            "minItems": 1
          }
        },
        "required": [
          "lane",
          "strategyFamily",
          "reconciliationIds"
        ]
      },
      "then": {
        "properties": {
          "requiredOutputFields": {
            "contains": {
              "const": "reconciliationIds"
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "lane": {
                "enum": [
                  "custom_pleading",
                  "acroform_fill",
                  "flat_pdf_overlay",
                  "composed_route",
                  "guidance_implementation"
                ]
              }
            },
            "required": ["lane"]
          },
          {
            "not": {
              "properties": {
                "strategyFamily": {
                  "const": "legal_design_adjudication"
                }
              },
              "required": ["strategyFamily"]
            }
          }
        ]
      },
      "then": {
        "required": [
          "regressionVerifier",
          "participantPacketProofRequired"
        ],
        "properties": {
          "participantPacketProofRequired": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "strategyFamily": {
            "const": "legal_design_adjudication"
          }
        },
        "required": ["strategyFamily"]
      },
      "then": {
        "required": ["participantPacketProofRequired"],
        "properties": {
          "participantPacketProofRequired": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "status": {
                "enum": ["planned", "ready", "blocked", "in_progress"]
              }
            },
            "required": ["status"]
          },
          {
            "properties": {
              "officialPdfAssignment": {
                "type": "object",
                "properties": {
                  "identityKeys": {
                    "type": "array",
                    "minItems": 1
                  }
                },
                "required": ["identityKeys"]
              }
            },
            "required": ["officialPdfAssignment"]
          }
        ]
      },
      "then": {
        "required": ["sourceMaterializationInputs"]
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "const": "legal_design_normalization"
          },
          "jobId": {
            "pattern": "-legal-design-normalization$"
          }
        },
        "required": ["lane", "jobId"]
      },
      "then": {
        "required": ["normalizationReadiness"]
      }
    }
  ],
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?\\[\\]{}!]).+$"
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "nonemptyPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
