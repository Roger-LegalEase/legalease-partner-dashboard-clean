{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalease.example/schemas/rcap-production-factory-job-v1.json",
  "title": "RCAP production factory job",
  "description": "A deterministic, path-bounded unit of nationwide record-clearing work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "parentJobId",
    "canonicalWave",
    "canonicalLane",
    "lane",
    "jurisdiction",
    "trackIds",
    "strategyFamily",
    "baseCommit",
    "dependencies",
    "ownedPaths",
    "integrationOwnedOutputs",
    "forbiddenPaths",
    "requiredInputs",
    "expectedOutputs",
    "requiredOutputFields",
    "focusedValidation",
    "integrationValidation",
    "model",
    "effort",
    "executionScope",
    "status",
    "commitSubject",
    "stopCondition"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "parentJobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
    },
    "canonicalWave": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "canonicalLane": {
      "enum": [
        "normalization",
        "authority",
        "platform",
        "implementation-pleading",
        "implementation-acroform",
        "implementation-overlay",
        "implementation-composed",
        "implementation-guidance",
        "proof",
        "counsel",
        "release"
      ]
    },
    "lane": {
      "enum": [
        "platform_foundation",
        "legal_design_normalization",
        "source_acquisition",
        "custom_pleading",
        "acroform_fill",
        "flat_pdf_overlay",
        "composed_route",
        "guidance_implementation",
        "legal_output_review",
        "staging_promotion"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^(?:[A-Z]{2}|NATIONWIDE)$"
    },
    "trackIds": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "strategyFamily": {
      "enum": [
        "platform_foundation",
        "legal_design",
        "source_acquisition",
        "in_repo_identity_reconciliation",
        "public_official_download",
        "official_download_automation_blocked",
        "direct_issuer_request",
        "commercial_license",
        "local_form_scope_correction",
        "source_identity_resolution",
        "not_required_design_reconciliation",
        "superseded_source_replacement",
        "edition_publication",
        "custom_pleading",
        "official_pdf_fill",
        "composed",
        "process_guidance",
        "legal_output_review",
        "staging_promotion"
      ]
    },
    "acquisitionIds": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "reconciliationIds": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "downloadedSourceCount": {
      "type": "integer",
      "minimum": 0
    },
    "completionCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "ownedPaths": {
      "$ref": "#/$defs/nonemptyPaths"
    },
    "integrationOwnedOutputs": {
      "$ref": "#/$defs/nonemptyPaths"
    },
    "forbiddenPaths": {
      "$ref": "#/$defs/paths"
    },
    "requiredInputs": {
      "$ref": "#/$defs/paths"
    },
    "expectedOutputs": {
      "$ref": "#/$defs/nonemptyPaths"
    },
    "requiredOutputFields": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "focusedValidation": {
      "$ref": "#/$defs/commands"
    },
    "integrationValidation": {
      "$ref": "#/$defs/commands"
    },
    "model": {
      "enum": [
        "opus",
        "codex"
      ]
    },
    "effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "executionScope": {
      "enum": [
        "worker",
        "captain",
        "human"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "ready",
        "blocked",
        "in_progress",
        "completed",
        "cancelled"
      ]
    },
    "commitSubject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\r\\n]+$"
    },
    "stopCondition": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lane": {
            "const": "source_acquisition"
          },
          "strategyFamily": {
            "not": {
              "const": "edition_publication"
            }
          }
        },
        "required": [
          "lane",
          "strategyFamily"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "acquisitionIds"
            ],
            "properties": {
              "acquisitionIds": {
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "reconciliationIds"
            ],
            "properties": {
              "reconciliationIds": {
                "minItems": 1
              }
            }
          }
        ],
        "properties": {
          "requiredOutputFields": {
            "contains": {
              "const": "downloadedSourceCount"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "const": "source_acquisition"
          },
          "strategyFamily": {
            "not": {
              "const": "edition_publication"
            }
          },
          "acquisitionIds": {
            "minItems": 1
          }
        },
        "required": [
          "lane",
          "strategyFamily",
          "acquisitionIds"
        ]
      },
      "then": {
        "properties": {
          "requiredOutputFields": {
            "contains": {
              "const": "acquisitionIds"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "const": "source_acquisition"
          },
          "strategyFamily": {
            "not": {
              "const": "edition_publication"
            }
          },
          "reconciliationIds": {
            "minItems": 1
          }
        },
        "required": [
          "lane",
          "strategyFamily",
          "reconciliationIds"
        ]
      },
      "then": {
        "properties": {
          "requiredOutputFields": {
            "contains": {
              "const": "reconciliationIds"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?\\[\\]{}!]).+$"
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "nonemptyPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
