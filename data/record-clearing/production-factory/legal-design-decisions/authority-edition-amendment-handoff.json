  "adoptedArchiveSha256": "7edd0a0e8308b58e12f59494a326342cc83dd362bb58f787e43d6fb475ef43bd",
  "whatThisIs": "The exact official-source identities a completed source-acquisition decision has already settled, which the adopted Master Library edition does not retain. They are not unresolved: the document, issuer, role and in most cases the exact bytes are established. They are not materializable either, because materialization runs only through the portable authority archive and these documents have no canonical archive entry. Closing that gap is an authority-edition amendment, not an acquisition and not a normalization. One row, Vermont's 600-00228, is retained in the adopted edition and is nonetheless withheld from assignment by that edition's own classification of it. It is recorded here because the remedy is the same amendment path, not because the bytes are missing; editionAmendmentKind distinguishes the two cases.",
  "requiredSequence": [
    "author canonical manifest rows for each identity",
    "record edition checksums",
    "retain the archive entries",
    "publish the successor edition and adopt it",
    "then ordinary portable materialization through the existing contract"
  ],
  "prohibitedShortcuts": [
    "copying a private-corpus binary into the portable source root",
    "materializing from a repository-only capture",
    "treating a resolved identity as unresolved",
    "publishing an edition inside a materialization pass"
  ],
