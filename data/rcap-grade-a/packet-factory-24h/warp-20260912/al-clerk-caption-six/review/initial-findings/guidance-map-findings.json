        },
        {
          "id": "AL-CURRENT-PRIOR-PETITION-CONDITION",
          "obligation": "REQUIRED_BEFORE_FILING",
          "finding": "Previous-expungement county/case required unconditionally although source limits them to the previous-application YES branch."
        },
        {
          "id": "AL-CURRENT-PARTICIPANT-ELECTION-HANDBACK",
          "obligation": "ROUTE_OPTIONS",
          "finding": "Source-required CR-65 p5 attachment, p6 prior-application selection and pro-se election remain unselected without the participant handback supplied in the other three family guides."
        },
        {
          "id": "AL-CURRENT-FEE-REQUEST-HANDBACK",
          "obligation": "FEE_AND_WAIVER",
          "finding": "Fee-waiver guide says complete affidavit but does not hand back its unselected expungement fee request; the other two printed requests concern counsel and ignition interlock fees. Felony DWOP already supplies the specific conditional expungement election."
        }
