  "findings": [
    {
      "id": "OR-S1",
      "obligations": [
        "COMPONENT_SET",
        "REQUIRED_BEFORE_FILING",
        "FILING_DESTINATION"
      ],
      "finding": "OSP is universally sequenced before filing and retained in the court-packet component list, without a jurisdiction/configuration sequence. This contradicts the current binding separate-agency-step disposition.",
      "locations": [
        "production-field-map.json componentSet and OR-OSP-SET-ASIDE-CCH.whole_form",
        "participant-instructions.md OSP required-before-filing item",
        "filing-instructions.md both THE ORDER OF THE STEPS MATTERS sections",
        "all4 assembled PDFs pages8-9"
      ],
      "governingDecision": "OR-OSP-SEPARATE-AGENCY-STEP",
      "currentQuote": "every entry on the Oregon State Police request form, which you send to the Oregon State Police with your fingerprint card before you file the motion",
      "repair": "Model OSP as a separately addressed required agency handoff; bind sequence to jurisdiction/configuration while preserving the current source form. Never mark the sworn fingerprints-filed statement merely because the agency form is enclosed. The printed declaration still requires truth; if local sequence and its wording need reconciliation, stop for that specific configuration rather than making a false attestation. No proposed-order source hunt is required by this review."
    },
    {
      "id": "OR-S2",
      "obligations": [
        "KNOWN_PREFILLS",
        "REQUIRED_BEFORE_FILING"
      ],
      "finding": "20 available neutral identity facts are withheld by whole-form/manual or signature policies: four defendant printed names on mailing certificates and16 OSP identity/destination fields. A printed name is not a signature or evidence that mailing occurred.",
      "measurement": "knownFactOmissions",
      "locations": [
        "MOTION_POLICY p5.r115.6.x288.rule",
        "ospFieldMap() documentAcceptsFill false; whole_form single refusal"
      ],
      "repair": "Fill supported neutral identity/destination facts through governed mappings; preserve actual mailing dates, signatures, fingerprint completion and other unheld facts. Name components must be collected or supported, never guessed. Convert DOB to the OSP printed MM/DD/YYYY format; do not fabricate aliases/phone."
    },
    {
      "id": "OR-S3",
      "obligations": [
        "ROUTE_OPTIONS",
        "REQUIRED_BEFORE_FILING"
      ],
      "finding": "All4 OSP forms leave both YES/NO blank for whether the motion includes a conviction, although both family routes determine NO. The whole-form refusal hides this route option.",
      "source": "OSP page1: Does the motion to set aside include a conviction? YES NO",
      "repair": "Inventory the agency form fields and controls. Mark NO for these exact routes; keep fingerprint-card and payment-completion attestations truthful and unselected unless actually supported. Preserve optional/conditional alias rows and additional court rows."
    },
    {
      "id": "OR-S4",
      "obligations": [
        "REPEATING_ROWS",
        "ROUTE_OPTIONS",
        "REQUIRED_BEFORE_FILING"
      ],
      "finding": "The court source has five physical bullet rows for citation/arrest offences (3 on page4,2 on page5); eight table border rules are classified as mandatory offence facts. No occurrence data or conditional-unused-row modeling exists, and the page5 additional-offences checkbox has no census/handback despite build-findings claiming the guide supplies one. SID/FPN labelled if known are also unconditionally REQUIRED_BEFORE_FILING.",
      "locations": [
        "CITATION_OFFENCE_LINE and eight MOTION_POLICY keys",
        "production-field-map.json requiredBeforeFiling lines1-8 and SID/FPN",
        "build-findings.json four unmeasured controls claim",
        "participant-instructions.md lacks additional-page instruction"
      ],
      "repair": "Measure actual five writable rows separately from border/header rules, require actual offence items, condition unused rows on item count, support overflow with correct participant attachment/checkbox handling, and make SID/FPN if-known conditions explicit. Do not invent additional offences to satisfy eight declared blanks."
    },
    {
      "id": "OR-S5",
      "obligations": [
        "SERVICE",
        "REQUIRED_BEFORE_FILING"
      ],
      "finding": "Both prosecutor mailing-address lines are classified NOT_APPLICABLE_ON_THIS_ROUTE because no attorney-representation fact is held. They are recipient-address fields for the prosecutor, not the participant attorney; the primary required recipient address disappears from the generated required-before-filing list.",
      "locations": [
        "reports/blanks-left-for-the-participant.json p5.r211.1.x432.rule and p5.r192.4.x72.rule on both route documents"
      ],
      "currentQuote": "no attorney-representation fact is held for this participant",
      "repair": "Use the printed service-recipient role. Require/collect the first recipient-address line before certifying actual mailing; make the second line conditional on address length. The official District Attorney locator is already supplied on OJD page3. Keep service dates/signatures blank until performed."
    },
    {
      "id": "OR-S6",
      "obligations": [
        "ARTIFACTS"
      ],
      "finding": "All4 delivered PDFs print internal obligation:track-only route keys on the final instructions; participant instructions also expose source SHA inventories and internal family/fixture terminology. Further, all30 reports/actual-writes entries have null page,drawnText,expected but assert visibleInArtifactBytes/everyWidgetVisibleInArtifactBytes true and derivedFromArtifactBytes true.",
      "locations": [
        "composedBody final Route key",
        "instructionsMarkdown Sources section",
        "run writeProofs mapping report fields"
      ],
      "repair": "Remove implementation identifiers from delivered participant copy. Repair the byte evidence to report actual saved values/pages/positions or truthfully label unavailable measurements. The reviewer independently located all30 held writes; no invisible-write defect is inferred solely from broken counters."
    },
    {
      "id": "OR-S7",
      "obligations": [
        "FEE_AND_WAIVER"
      ],
      "finding": "Composed guidance calls the OSP background-check fee a different charge and tells every nonconviction participant to ask OSP, without explaining the held form\u2019s express conviction-only fee condition. The OSP opening paragraph says $33 unconditionally but its operative checklist/page2 and current OJD page2 explicitly restrict this fee to convictions; the packet provides no route-specific clarification.",
      "sourceQuotes": [
        "OJD page2: Pay the Oregon State Police fee if you are asking the court to seal a conviction.",
        "OSP page2: The fee for an Oregon fingerprint-based Criminal record check for motions to set aside convictions is $33.00."
      ],
      "repair": "State the supported conviction-only condition for these nonconviction packets and distinguish any fingerprint-provider charge. Keep court filing no-fee treatment. Do not reopen a broad current-fee source hunt or invent a fee waiver."
    },
    {
      "id": "OR-S8",
      "obligations": [
        "REQUIRED_BEFORE_FILING",
        "SELF_HELP_STOP"
      ],
