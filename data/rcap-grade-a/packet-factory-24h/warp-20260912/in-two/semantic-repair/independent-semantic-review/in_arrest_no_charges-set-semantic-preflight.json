  "findings": [
    {
      "id": "IN-REPAIR-COURT-TYPE-KNOWN-OMISSIONS",
      "obligations": [
        "KNOWN_PREFILLS",
        "REQUIRED_BEFORE_FILING"
      ],
      "occurrences": 8,
      "actualDefect": "All four neutral court-type caption occurrences in both bundles remain blank, although canonical matter.court is Marion Superior Court and boundary matter.court is Saint Joseph Circuit Court. Official options are SUPERIOR, CIRCUIT, ____________, CITY, TOWN. The current map falsely says no court fact is held; finalizer reports value_not_among_field_options.",
      "fields": [
        "packet/DD-cap-CourtType"
      ],
      "pages": [
        1,
        3,
        7,
        9
      ],
      "repair": "Map the exact held court type to the official option/occurrences; retain clerk-assigned cause number and protected judicial fields blank."
    },
    {
      "id": "IN-REPAIR-COUNTY-OCCURRENCE-ACTOR",
      "obligations": [
        "KNOWN_PREFILLS",
        "REQUIRED_BEFORE_FILING"
      ],
      "occurrences": 6,
      "actualDefect": "The shared County field is refused wholesale as a court directive. The participant petition p5 county sheriff label and p13 local prosecutor/sheriff recipient county labels are neutral held county facts, but all six canonical/boundary occurrences are blank.",
      "fields": [
        "packet/County"
      ],
      "pages": [
        5,
        13
      ],
      "explicitExclusions": [
        "p14 transfer-to-another-county clerk: unknown conditional county remains blank",
        "p12 judicial decree is outside this measured missing-neutral set"
      ],
      "repair": "Use exact source occurrence ownership. Fill only supported local county labels and keep judicial choices, service certifications, agency mailing addresses and conditional other-county recipient facts protected/unknown."
    },
    {
      "id": "IN-REPAIR-GUIDE-FILING-AND-FEE-REGRESSION",
      "obligations": [
        "FILING_DESTINATION",
        "FEE_AND_WAIVER"
      ],
      "actualDefect": "The replacement participant guide omitted both the filing county rule and the explicit no-filing-fee/no-waiver instructions; these obligations passed in the initial review and are newly regressed. Saying ask the clerk which court type is not a filing destination rule.",
      "governingRules": {
        "filing": "File the verified petition, order, appearance where self-represented, Notice of Exclusion and Confidential Information Form with a circuit or superior court in the county where the charges were filed, or where the arrest occurred if none were filed.",
        "fees": "None. Section 1 petitions carry no filing fee.",
        "feeWaiver": "Not applicable. There is no fee.",
        "notice": "The court serves a copy of the petition on the prosecuting attorney under \u00a7 35-38-9-1(f). The court shall grant unless the subsection (a) conditions are unmet or criminal charges are pending, and may summarily deny a petition that shows on its face that the person is not entitled to relief.",
        "service": "The court serves the prosecuting attorney. The CCA appearance form nonetheless carries a certificate of service to the county prosecutor; follow the form.",
        "participantSignature": "The petition is verified and signed by the petitioner.",
        "notarization": "none"
      },
      "repair": "Restore circuit/superior court in county of charges/allegation, or county of arrest if none; Section1 has no filing fee and no waiver application is needed."
    },
    {
      "id": "IN-REPAIR-PARTICIPANT-INTERNAL-COPY",
      "obligations": [
        "ARTIFACTS"
      ],
      "actualDefect": "Participant-facing guide still exposes internal AcroForm names; Section1 additionally exposes a repository registry path and track/property names. The focused test explicitly requires the checkbox IDs, so passing that test does not prove customer-readable guidance.",
      "exactCurrentLines": [
        {
          "line": 11,
          "text": "The packet writes held identity, contact, county, arrest and no-charge facts only in their printed participant or neutral-record locations. It keeps the clerk-assigned XP cause number separate from any prosecutor declination reference. The source-defined participant choices already marked on each Facts set are `Check Box19`, `Check Box25`. Check every prefilled fact against your records before filing."
        },
        {
          "line": 15,
          "text": "- Sign and verify the petition yourself. Fill the last four digits of your Social Security number on the petition and the full number only on the Confidential Information Form and Exhibit A where printed (source field PetFullSSN)."
        }
      ],
      "repair": "Describe each already-selected printed choice in plain language and refer to physical form labels/pages. Keep source field IDs and registry keys only in evidence."
    },
    {
      "id": "IN-REPAIR-ALIAS-AND-AGENCY-HANDBACK",
      "obligations": [
        "REQUIRED_BEFORE_FILING"
      ],
      "actualDefect": "Packet PetitionerAliases is still classified wholly court-owned even though the same field has a participant alias question on petition p3. Packet County/LEA1-3 likewise have participant-request occurrences on p5, yet the guide only discusses the order agency blocks. Alias handback mentions ExhibitA generally but the machine policy wrongly exempts the p3 participant occurrence; required applicable participant agency names on p5 are not specifically handed back.",
      "fields": [
        "packet/PetitionerAliases p3",
        "packet/LEA1",
        "packet/LEA2",
        "packet/LEA3 p5"
      ],
      "repair": "Classify shared occurrences by printed actor and make applicable petition alias/record-holding-agency handback explicit. Do not fabricate alias history, agency identity, or agency addresses."
    },
    {
      "id": "IN-REPAIR-ARREST-HEARING-STOP",
      "obligations": [
        "SELF_HELP_STOP"
      ],
      "actualDefect": "The no-charge guide reproduces other stops but omits the current track requirement to stop when the court sets a hearing.",
      "requiredStatement": "The court sets a hearing.",
      "repair": "Restore the hearing stop in participant language."
    }
  ],
