    "threeRetainedReleaseQuestions": [
      {
        "questionIndex": 0,
        "affectedElement": "packet_components",
        "impact": "release_blocker",
        "question": "Is CR360 with an attached continuation carrying the \u00a7 610.140.7 allegations the correct presentation of an arrest-only petition, or does Missouri practice expect the form's conviction-specific sentences to be struck through or adapted? Confirm with counsel and, if possible, with a circuit clerk before release."
      },
      {
        "questionIndex": 1,
        "affectedElement": "filing_process",
        "impact": "release_blocker",
        "question": "Confirm with the Office of the State Courts Administrator or a circuit clerk that a \u00a7 610.140.7 arrest-only petition is filed under case type X5 and not XG."
      },
      {
        "questionIndex": 2,
        "affectedElement": "eligibility_branch",
        "impact": "release_blocker",
        "question": "Does an expungement granted under \u00a7 610.140.7 for an arrest with no charge filed count against the \u00a7 610.140.13 lifetime caps, and if so at what level? The subsection counts offenses, not arrests."
      }
    ],
    "settledBuildIdentity": "Existing memo authorizes CR360 with required section 610.140.7 continuation, X5 and eighteen-month county-of-arrest route as a build candidate. It expressly retains three release questions. Do not revive resolved CR370 custody or obsolete three-year waiting claims.",
