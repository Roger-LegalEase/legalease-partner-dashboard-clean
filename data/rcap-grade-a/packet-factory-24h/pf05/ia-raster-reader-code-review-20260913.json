  "findings": [
    {
      "id": "PF05-IA-RAS-CODE-001",
      "severity": "BLOCKING",
      "title": "IA packet path is not required to be an exact relative fixture path",
      "location": "scripts/grade-a-packet-factory-24h/conditional-raster-documents.mjs:53-59",
      "impact": "The reader accepts a report path that violates the repository-relative exact-output contract. A later queue/receipt can therefore carry normalized or absolute path identity without the reader refusing the candidate; the current bytes happen to be the same target, but the declaration is not fail-closed.",
      "observed": "The check compares path.resolve(root, packet.path) with the real fixture target. Normalization happens before comparison, and there is no absolute-path or raw dot-dot-segment rejection.",
      "reproduction": [
        {
          "mutation": "packet.path = absolute exact fixture path",
          "result": "ACCEPTED"
        },
        {
          "mutation": "packet.path = data/.../fixtures/canonical.pdf/../canonical.pdf",
          "result": "ACCEPTED"
        },
        {
          "mutation": "packet.path = data/.../fixtures/../fixtures/canonical.pdf",
          "result": "ACCEPTED"
        }
      ],
      "requiredFix": "Reject absolute packet.path values and any raw . or .. traversal segments before resolution, or require packet.path to equal the exact repository-relative family fixtures/<fixture>.pdf string. Add focused absolute-exact and dot-dot mutation controls."
    },
    {
      "id": "PF05-IA-RAS-CODE-002",
      "severity": "BLOCKING",
      "title": "IA fixture inventory ignores extra symlinked and nested PDFs",
      "location": "scripts/grade-a-packet-factory-24h/conditional-raster-documents.mjs:42-45",
      "impact": "The helper can accept a fixture directory containing an unrecognized PDF output while returning a complete six/eight-fixture set. The queue discovery is recursive, so this leaves an output outside the reader selection and defeats the required extra/unsafe-output fail-closed gate.",
      "observed": "actualNames filters only direct Dirent.isFile() entries ending in lowercase .pdf. Symlinks are excluded from the inventory and nested PDFs are never enumerated; neither is rejected.",
      "reproduction": [
        {
          "mutation": "extra-symlink.pdf -> canonical.pdf in fixtures/",
          "result": "ACCEPTED; selectedCount=6"
        },
        {
          "mutation": "fixtures/extra-dir/extra.pdf regular nested output",
          "result": "ACCEPTED; selectedCount=6"
        }
      ],
      "requiredFix": "For these flat IA fixture directories, enumerate every entry and reject symlinks, subdirectories, and any extra PDF/output; otherwise recursively enumerate and compare the complete regular-file inventory. Add extra regular, extra symlink, nested, and replacement-symlink controls."
    }
  ],
