+test("a self-test dispatch through an argv default bound to process.argv is found", () => {
+  const root = stage();
+  builder(root, "build-census-v1-ut_pet_cannabis-set.mjs", `import assert from "node:assert/strict";
+function runSelfTests() {
+  assert.equal(1, 1, "a delivered-output invariant");
+}
+async function runFamilyById(familyId, argv = process.argv.slice(2)) {
+  if (argv.includes("--self-test")) return runSelfTests();
+  return familyId;
+}
+await runFamilyById("example");
+`);
+  const scope = scopeOf(root);
+  assert.deepEqual(scope.map((row) => row.builder), ["build-census-v1-ut_pet_cannabis-set.mjs"]);
+  assert.equal(scope[0].assertions, 1);
+});
