  "command": "node scripts/rcap-packet-completeness/verify-packet-completeness.mjs --write",
  "whyBeforeAndAfterAreIdentical": "This lane renders no packet and writes into no overlay directory. The completeness matrix is measured from rendered overlay artifacts, so a change to shared build logic cannot move it until a lane that owns a packet re-renders. The before and after runs are therefore byte-identical, and that is the correct result rather than a null one: it is the evidence that the correction stayed inside the host. What the correction does is measured separately, by projection.",
  "projection": {
    "what": "The corrected host emission logic applied to each closure family already-captured field census and field map, written into a mirror of the overlay tree and read by the same unmodified verifier.",
    "script": "data/rcap-grade-a/wave-2/s2-shared-ne-setaside-host-completeness/project-corrected-host.mjs",
    "rendersAnything": false,
    "writesIntoAnyOverlayDirectory": false,
    "isNotProof": "A projection is not a render. It states what P1, P3 and P4 should expect the audit to say once they re-render against the corrected host; only their re-render proves it.",
    "howToRerun": [
      "mkdir -p $M/scripts $M/data/rcap-all50/overlays/census-v1 $M/data/rcap-grade-a/launch-control",
      "cp -r scripts/rcap-packet-completeness $M/scripts/",
      "cp data/rcap-grade-a/launch-control/C11_RETURN_REVIEW.json $M/data/rcap-grade-a/launch-control/",
      "symlink every overlay family directory into $M/data/rcap-all50/overlays/census-v1/<state>/",
      "S2_PROJECTION_MIRROR=$M node data/rcap-grade-a/wave-2/s2-shared-ne-setaside-host-completeness/project-corrected-host.mjs <the eleven closure family ids>",
      "node $M/scripts/rcap-packet-completeness/verify-packet-completeness.mjs --write"
    ],
    "reproduced": true
  },
