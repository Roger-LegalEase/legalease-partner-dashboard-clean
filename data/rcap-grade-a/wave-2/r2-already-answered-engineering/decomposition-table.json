{
  "schemaVersion": "rcap-grade-a-r2-output-mode-decomposition/v1",
  "what": "The controlling decision records state an output treatment in counsel's prose vocabulary. The runtime states it in RouteOutcomeMode. This table is the one place the two vocabularies are joined, so the join is reviewable as a table rather than buried in a regular expression.",
  "keyedBy": "the exact outputMode string carried by the decision record in src/lib/legal-authority/authority.json",
  "runtimeVocabularySource": {
    "file": "src/lib/legal-authority/types.ts",
    "field": "RouteOutcomeMode, RouteStage, NO_PARTICIPANT_FILING_OUTCOMES, PACKET_BEARING_OUTCOMES"
  },
  "compositionMeanings": {
    "disjoint_branches": "The record joins the treatments with OR. Exactly one branch serves a given matter, and the branches may not share a checkout path.",
    "conjunctive_branches": "The record joins the treatments with +. Both are owed on the same matter; neither replaces the other."
  },
  "packetFamilyRule": "Every branch this lane emits carries packetFamily null. Binding a packet family is a packet-factory act with its own approval; this lane implements the outcome-mode decision only, which is why it opens no commercial route.",
