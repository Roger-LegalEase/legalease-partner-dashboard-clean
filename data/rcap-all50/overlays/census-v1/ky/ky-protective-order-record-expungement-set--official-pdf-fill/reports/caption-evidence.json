            "node": "participantInputs.poRespondentName",
            "quote": "What is your full name as it appears on the case?",
            "establishes": "the participant's OWN name goes in the respondent slot"
          },
          {
            "node": "participantInputs.poPetitionerName",
            "quote": "What is the name of the person who petitioned against you?",
            "establishes": "the petitioner is the person who petitioned AGAINST the participant"
          },
          {
            "node": "controllingAuthority.summary",
            "quote": "Where a protective-order petition did not result in the issuance of a domestic violence order or a non-temporary interpersonal protective order and the case was dismissed, the court may for good cause shown order expunged all records in the case in the custody of the court and any such records, including law enforcement records, in the custody of any other agency or official. The respondent moves six months after dismissal, provided no order of protection has been issued against them in the preceding six months.",
            "establishes": "the moving party is the respondent"
          },
          {
            "node": "exclusions",
            "quote": "Any respondent who has been bound by, or had issued against them, an order of protection for the protection of any person in the six months before the request.",
            "establishes": "the six-month exclusion is written about the respondent"
          },
          {
            "node": "destination.detail",
            "quote": "Filed in the protective-order case. The clerk verifies the signature, applies the filed stamp, completes the notification-of-hearing section on the face of the form, creates the scheduled event and requests an updated criminal and protective-order history for the respondent.",
            "establishes": "the clerk pulls the history of the respondent"
          }
        ],
