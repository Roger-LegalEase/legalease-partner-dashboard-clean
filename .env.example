NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ENABLE_SUPABASE_PARTNER_DATA=true
# Server-only, default-off rollout gate for the authenticated Phase 1 workspace.
RCAP_PARTNER_ONBOARDING_ENABLED=false
# Default-off server flag for reviewed LegalEase onboarding prefill suggestions.
# Requires RCAP_PARTNER_ONBOARDING_ENABLED=true and is not exposed to browsers.
RCAP_ONBOARDING_PREFILL_ENABLED=
# Default-off server flag for Phase 2A launch-preparation artifacts: generated
# partner documents, their versions, and LegalEase/partner review. Requires
# RCAP_PARTNER_ONBOARDING_ENABLED=true and is not exposed to browsers. It grants
# no publication, invitation, or activation capability.
RCAP_ONBOARDING_LAUNCH_PREP_ENABLED=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LEGACY_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPUNGEMENT_AI_CHECKOUT_DRY_RUN=
NEXT_PUBLIC_PARTNER_APP_URL=https://legaleasepartner.com
NEXT_PUBLIC_EXPUNGEMENT_AI_URL=https://expungement.ai
# The LegalEase web origin. legalease.law is the email domain, not the site origin:
# src/lib/app-url.ts defines productionLegalEaseUrl as legalease.com and src/proxy.ts
# maps the www.legalease.com host, so this template was the outlier.
NEXT_PUBLIC_LEGALEASE_URL=https://legalease.com
NEXT_PUBLIC_APP_URL=https://legaleasepartner.com

# Where a partner is told to write when they are blocked in RCAP onboarding. Optional.
# Leave unset to use the built-in fallback, partners@legalease.com. Set this only to a
# monitored, forwarding mailbox: it is shown to partners as a live mailto link on every
# blocker, failure and empty state, so an unmonitored address is worse than none.
RCAP_PARTNER_SUPPORT_EMAIL=

ENABLE_PARTNER_EMAIL_DELIVERY=false
PARTNER_EMAIL_PROVIDER=resend
EXPUNGEMENT_EMAIL_PROVIDER=resend
RESEND_API_KEY=
EXPUNGEMENT_EMAIL_FROM=
EXPUNGEMENT_EMAIL_REPLY_TO=
PARTNER_EMAIL_FROM=
PARTNER_EMAIL_REPLY_TO=
INTERNAL_LEGALEASE_NOTIFICATIONS_EMAIL=

PARTNER_PREVIEW_ACCESS_TOKEN=

# LegalEase Command Center events. One shared HMAC secret, one enable flag, two endpoints —
# the receiver exposes two routes that speak different, incompatible dialects.
#   LEGALEASE_OS_EVENTS_ENDPOINT -> /api/events/product   (camelCase eventType; the product funnel)
#   LEGALEASE_OS_LOOPS_ENDPOINT  -> /api/os-loops/events  (snake_case event_type; engine/packet/nudge)
# Pointing either dialect at the other's route returns a 400 and silently drops the event.
LEGALEASE_OS_EVENTS_ENABLED=false
LEGALEASE_OS_EVENTS_ENDPOINT=
LEGALEASE_OS_LOOPS_ENDPOINT=
LEGALEASE_OS_EVENTS_SECRET=

ENABLE_RCAP_CAPTCHA=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Content platform (phase 43) — outbound promotion to the LegalEase Command Center.
# Leave disabled until the Command Center receiving endpoint is deployed. While disabled the CMS
# reports an honest "Not connected" state and offers a local JSON export instead of pretending to send.
COMMAND_CENTER_CONTENT_EVENTS_ENABLED=false
COMMAND_CENTER_CONTENT_EVENTS_ENDPOINT=
COMMAND_CENTER_CONTENT_SIGNING_SECRET=

# Promotion Studio AI drafting. Disabled by default; manual drafting, branded assets, approval,
# JSON export, and the disconnected Command Center state continue to work with these unset.
CONTENT_PROMOTION_AI_ENABLED=false
OPENAI_API_KEY=
CONTENT_PROMOTION_OPENAI_MODEL=

# Shared bearer secret for POST /api/content/scheduler/run (the cron that publishes scheduled posts).
# When unset the scheduler route returns 503 rather than running unprotected.
CONTENT_SCHEDULER_SECRET=
