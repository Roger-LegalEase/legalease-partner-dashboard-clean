# Build-context allowlist for the render-worker image (BuildKit reads
# <dockerfile>.dockerignore in preference to a context-root .dockerignore).
#
# The repository root carries ~1.1 GB of data/ and the private/ source corpus.
# Neither belongs in a build context: private/ is never a runtime input, and
# data/ is build- and review-material apart from the small read-only closure
# the worker reads. Excluding everything first and re-including exactly the
# build inputs means a new file under data/ or private/ cannot drift into the
# image, and the context stays small enough to send quickly.
*

!package.json
!package-lock.json
!tsconfig.json
!scripts/rcap-render-worker.mjs
!scripts/lib
!scripts/rcap-custom-pleading/court-facing-rows.mjs
!src
!deploy/rcap-render-worker/Dockerfile
!deploy/rcap-render-worker/runtime-data-manifest.json
!deploy/rcap-render-worker/preflight.mjs

# Read-only runtime data: exactly runtime-data-manifest.json, nothing else.
!data/rcap-grade-a/worker-static-authority.json
!data/rcap-grade-a/maintenance/route-holds.json
!data/rcap-codex/release-readiness.json
!data/rcap-all50/problematic-pdf-register.json
!data/rcap-all50/review-artifacts/f2-dispositions.json
!data/rcap-all50/guidance-packets
!data/rcap-all50/composed-routes/**/route.json
!data/rcap-all50/terminalization-treatments
!data/rcap-ledger/packet-fulfillment-records.json
!data/rcap-ledger/packet-correction-required.json
!data/rcap-ledger/route-kind-adjudications.json
!data/rcap-ledger/route-presentation-conflicts.json
!data/rcap-ledger/track-pathway-crosswalk.json
!data/record-clearing/factory-v2-route-registry.json
!data/record-clearing/legal-design-packet-set-manifests.json
!data/record-clearing/legal-decisions/route-ratification-registry.json
!data/record-clearing/packet-specifications

# §7. The guides are static ESM imports in guide-registry.ts, so the module
# graph will not load without them; the brand asset is read at render time and
# the guide renderer now refuses rather than degrading to a text wordmark.
!data/record-clearing/supplemental-guides
!data/record-clearing/brand/legalease-logo.png

# The Mississippi paid-consumer successor chain, its review evidence and the
# approved bytes themselves.
#
# The loader walks the whole supersession chain and hashes the approved PDFs, so
# a file missing from the image does not fail the build or crash the worker --
# it makes the loader return null, which quietly withdraws the owner's scope.
# Every path the Dockerfile COPYs has to appear here, and
# scripts/test-worker-image-copy-context-agreement.mjs now proves it does: this
# list and the Dockerfile's COPY set went out of step once, and the result was
# an image that could not be built at all.
!data/record-clearing/legal-decisions/2026-09-20-ms-nonconv-paid-consumer-successor-v3.json
!data/record-clearing/legal-decisions/2026-09-20-ms-nonconv-paid-consumer-successor-v2.json
!data/record-clearing/legal-decisions/2026-09-14-ms-nonconv-paid-consumer-successor.json
!data/rcap-ledger/grade-a/ms-nonconviction-successor-review.evidence.json
!data/rcap-ledger/grade-a/ms-nonconviction-clinic-demo.artifacts.json
!data/rcap-ledger/grade-a/ms-nonconviction-clinic-demo.participant-delivery.raster-review.json
!data/rcap-ledger/grade-a/artifacts/ms-nonconviction-successor-review-full-en.pdf
!data/rcap-ledger/grade-a/artifacts/ms-nonconviction-successor-review-full-es.pdf
!data/rcap-ledger/grade-a/artifacts/ms-nonconviction-2026-10-20/full-es.pdf
!data/rcap-ledger/grade-a/artifacts/ms-nonconviction-successor-review-court-only.pdf

# Nothing below is ever a build input, even if re-included by a pattern above.
**/node_modules
**/.git
**/.env
**/.env.*
**/*.pem
**/*.key

# Test authority, transport doubles and database harnesses are external mounts
# for disposable integration tests, never packaged runtime inputs.
scripts/lib/*-test-*.mjs
scripts/lib/rcap-ephemeral-pg.mjs
scripts/lib/rcap-onboarding-artifact-fixture.mjs
