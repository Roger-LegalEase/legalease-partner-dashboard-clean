# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

tmp/*
# RCAP all-50 QA/attorney review handoff artifacts are committed for team review.
# Only the all50 review-inbox subtree is tracked; other tmp/review-inbox output
# (e.g. overlay-factory candidates) stays ignored.
!tmp/review-inbox/
tmp/review-inbox/*
!tmp/review-inbox/all50/

# Local official PDF forms - do not commit
private/
*.zip
data/record-clearing/pdf-inspection/latest-report.json
data/record-clearing/pdf-inspection/latest-report.md
data/record-clearing/pdf-inspection/migration-triage.json
data/record-clearing/pdf-inspection/migration-triage.md
tmp/record-clearing-shadow/

# Local working artifacts (screenshots, scratch unzips) - never commit
.screenshots/
scratch-files17/
.rcap-mutation/

# Built source packs hold official court PDFs at their canonical Master Library
# paths. They are not this repository's to redistribute and a pack that lands in
# the index once is in the history forever, so the factory writes them here and
# refuses to build into a path git would track. The committed half of a pack is
# its manifest under data/rcap-all50/source-packs/.
tmp/source-packs/
